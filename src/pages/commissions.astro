---
import Layout from '../layouts/Layout.astro';
import CommissionItem from '../components/CommissionItem.astro';
import SiteFooter from '../components/SiteFooter.astro';
import avatar from '../assets/whiteyedcat/avatar.png';
import commissionsCat from '../assets/whiteyedcat/commissions-cat.png';
import commissionsDivider from '../assets/whiteyedcat/commissions-divider.png';
import commissionsPortrait from '../assets/whiteyedcat/commissions-portrait.png';
import commissionsStickers from '../assets/whiteyedcat/commissions-stickers.png';
import galleryA from '../assets/whiteyedcat/gallery-a.png';
import galleryB from '../assets/whiteyedcat/gallery-b.png';

const navigation = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/#about' },
	{ label: 'Artworks', href: '/artworks' },
	{ label: 'Collabs', href: '/collabs' },
	{ label: 'Commissions', href: '/commissions' },
	{ label: 'Exhibitions', href: '/exhibitions' },
	{ label: 'Contact', href: '/contact' },
];

const commissionItems = [
	{
		id: 'portraits',
		title: 'Portraits',
		description:
			'Illustrated portraits for people. Pop-art meets hyperrealism. Each piece is unique and painted with intention.',
		images: [
			{
				src: commissionsPortrait,
				alt: 'Colorful portrait commission preview featuring a dog surrounded by bright objects and painted details.',
			},
			{
				src: galleryA,
				alt: 'Colorful mixed-media portrait artwork with bright charms and playful details.',
			},
			{
				src: galleryB,
				alt: 'Painterly portrait framed by dark green flowing forms.',
			},
		],
		defaultVariant: 'no-background',
		variants: [
			{
				id: 'no-background',
				label: 'no background',
				choices: [
					{ label: 'Face only', price: 'RM200' },
					{ label: 'Half body', price: 'RM300' },
					{ label: 'Full body', price: 'RM350' },
				],
			},
			{
				id: 'with-background',
				label: 'with background',
				choices: [
					{ label: 'Face only', price: 'RM300' },
					{ label: 'Half body', price: 'RM350' },
					{ label: 'Full body', price: 'RM400' },
				],
			},
		],
	},
	{
		id: 'pet-portraits',
		title: 'Pet Portraits',
		description:
			'Illustrated portraits for pets. Pop-art meets hyperrealism. Each piece is unique and painted with intention.',
		images: [
			{
				src: commissionsPortrait,
				alt: 'Colorful pet portrait commission preview with dogs and playful surrounding details.',
			},
			{
				src: galleryA,
				alt: 'Bright mixed-media pet artwork with dogs, charms, and saturated details.',
			},
		],
		defaultVariant: 'no-background',
		variants: [
			{
				id: 'no-background',
				label: 'no background',
				choices: [{ label: 'Any animal', price: 'RM50' }],
			},
			{
				id: 'with-background',
				label: 'with background',
				choices: [{ label: 'Any animal', price: 'RM100' }],
			},
		],
	},
	{
		id: 'scenery',
		title: 'Scenery',
		description:
			'Original digital paintings of landscapes, cityscapes, and fantasy environments. Painted with mood and atmosphere in mind - each piece tells a story without a subject.',
		images: [
			{
				src: commissionsPortrait,
				alt: 'Colorful commission preview standing in for scenery artwork.',
			},
			{
				src: galleryB,
				alt: 'Painterly artwork with atmospheric flowing green forms.',
			},
		],
		choices: [{ label: 'One scene', prefix: 'from', price: 'RM500' }],
	},
	{
		id: 'pet-sticker-pack',
		title: 'Pet sticker pack',
		description: 'Custom illustrated sticker sets. Great for Telegram, LINE, or printing.',
		images: [
			{
				src: commissionsStickers,
				alt: 'Sticker pack preview with small illustrated cats and playful animal poses.',
			},
			{
				src: commissionsCat,
				alt: 'Orange cat illustration used as a pet sticker style preview.',
			},
		],
		choices: [{ label: 'Per 8 stickers', price: 'RM30' }],
		imageFit: 'contain',
	},
];

---

<Layout
	title="Commissions | whiteyedcat"
	description="Commission whiteyedcat for custom portraits, pet portraits, scenery paintings, and sticker packs with current Malaysian Ringgit rates and contact links."
>
	<main class="commissions-page">
		<header class="commissions-header">
			<div class="artist-lockup">
				<img src={avatar.src} alt="whiteyedcat illustrated profile avatar." loading="eager" decoding="async" />
				<div class="artist-lockup__copy">
					<div class="artist-lockup__topline">
						<h1>whiteyedcat</h1>
						<div class="social-links" aria-label="Social links">
							<a href="https://x.com/whiteyedcat" aria-label="X">X</a>
							<a href="https://www.instagram.com/whiteyedcat/" aria-label="Instagram">
								<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
									<rect x="5" y="5" width="14" height="14" rx="4"></rect>
									<circle cx="12" cy="12" r="3.2"></circle>
									<circle cx="16.3" cy="7.7" r="0.8"></circle>
								</svg>
							</a>
							<a href="https://www.threads.net/@whiteyedcat" aria-label="Threads">@</a>
						</div>
					</div>
					<div class="role-pills" aria-label="Creative roles">
						<span class="role-pill">
							<span aria-hidden="true">✦</span>
							painter
						</span>
						<span class="role-pill">
							<span aria-hidden="true">✦</span>
							illustrator
						</span>
					</div>
					<p>I live for garage survival...and cats</p>
				</div>
			</div>

			<nav class="commissions-nav" aria-label="Primary">
				{
					navigation.map((item) => (
						<a href={item.href} aria-current={item.href === '/commissions' ? 'page' : undefined}>{item.label}</a>
					))
				}
			</nav>
		</header>

		<section class="commissions-section" aria-labelledby="commissions-heading">
			<h2 id="commissions-heading">Commissions</h2>
			<div class="commissions-list">
				{
					commissionItems.map((item) => (
						<CommissionItem {...item} />
					))
				}
			</div>
		</section>

		<div class="commissions-divider" aria-hidden="true">
			<img src={commissionsDivider.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="commissions-cta" aria-labelledby="commissions-cta-heading">
			<div class="commissions-cta__body">
				<h2 id="commissions-cta-heading">You want to commission me?</h2>
				<div class="contact-methods">
					<div class="contact-method">
						<p>Send me an email at</p>
						<a class="contact-chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
							</svg>
							<span>whiteyedcat@gmail</span>
						</a>
					</div>
					<div class="contact-method">
						<p>Or DM me on</p>
						<a class="contact-chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
								<circle cx="12" cy="12" r="3.25"></circle>
								<circle cx="16.25" cy="7.75" r="0.8"></circle>
							</svg>
							<span>@whiteyedcat</span>
						</a>
					</div>
				</div>
			</div>
			<img class="commissions-cta__cat" src={commissionsCat.src} alt="" loading="lazy" decoding="async" />
		</section>

		<SiteFooter />
	</main>
</Layout>

<style>
	:root {
		--commissions-bg: #f9f5f2;
		--commissions-surface: #ffffff;
		--commissions-text: #121212;
		--commissions-inverse: #f2eee6;
		--commissions-footer: #0b0b0b;
		--commissions-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--commissions-footer);
		--site-footer-text: var(--commissions-inverse);
		--site-footer-shell: var(--commissions-shell);
		--site-footer-focus: var(--commissions-inverse);
	}

	.commissions-page {
		min-height: 100vh;
		background: var(--commissions-surface);
		color: var(--commissions-text);
		overflow: clip;
	}

	.commissions-header {
		background: var(--commissions-surface);
		padding: clamp(2rem, 5vw, 3.1rem) 1rem 1.45rem;
	}

	.artist-lockup {
		width: min(48rem, 100%);
		margin: 0 auto;
		display: grid;
		grid-template-columns: clamp(6.4rem, 16vw, 12rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.2rem, 3vw, 2rem);
	}

	.artist-lockup > img {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
	}

	.artist-lockup__copy {
		min-width: 0;
		display: grid;
		gap: 0.55rem;
	}

	.artist-lockup__topline {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 3vw, 2.2rem);
	}

	.artist-lockup h1,
	.commissions-footer__brand h2 {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-weight: 400;
		line-height: 0.92;
	}

	.artist-lockup h1 {
		font-size: clamp(3.9rem, 8.3vw, 6.25rem);
	}

	.social-links {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1;
	}

	.social-links a {
		display: inline-grid;
		place-items: center;
		width: 1rem;
		height: 1rem;
	}

	.social-links svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.role-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.role-pill {
		min-width: clamp(7rem, 15vw, 10.3rem);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.18rem 1rem 0.24rem;
		border: 2px solid var(--commissions-text);
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.artist-lockup p {
		margin: 0;
		font-size: clamp(0.95rem, 1.9vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
	}

	.commissions-nav {
		width: var(--commissions-shell);
		margin: clamp(1.8rem, 4vw, 3.15rem) auto 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: clamp(0.82rem, 1.4vw, 1rem);
		font-weight: 700;
	}

	.commissions-nav a {
		position: relative;
		padding-block: 0.3rem;
		white-space: nowrap;
	}

	.commissions-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 180ms ease;
	}

	.commissions-nav a:hover::after,
	.commissions-nav a:focus-visible::after,
	.commissions-nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.commissions-section {
		background: var(--commissions-surface);
		box-shadow: 0 0 0 100vmax var(--commissions-surface);
		clip-path: inset(0 -100vmax);
		width: var(--commissions-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(3.2rem, 6vw, 5.5rem);
	}

	.commissions-section h2,
	.commissions-cta h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
		text-align: center;
	}

	.commissions-list {
		width: min(72rem, 100%);
		margin: clamp(2.2rem, 4vw, 3.8rem) auto 0;
		display: grid;
		gap: clamp(1.2rem, 3vw, 2rem);
	}

	.commissions-divider {
		width: min(1281px, calc(100% + 2px));
		margin: clamp(-0.2rem, 1vw, 0.8rem) auto 0;
		pointer-events: none;
	}

	.commissions-divider img {
		width: 100%;
		height: auto;
	}

	.commissions-cta {
		position: relative;
		width: var(--commissions-shell);
		min-height: clamp(22rem, 35vw, 28rem);
		margin: 0 auto;
		margin-bottom: 100px;
		padding: clamp(3.3rem, 7vw, 6.5rem) 0 clamp(7.5rem, 14vw, 10.4rem);
		display: grid;
		place-items: center;
		text-align: center;
		isolation: isolate;
	}

	.commissions-cta__body {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: clamp(1rem, 2vw, 1.4rem);
	}

	.commissions-cta__cat {
		position: absolute;
		right: clamp(0rem, 3vw, 2.4rem);
		bottom: clamp(2rem, 5vw, 4.6rem);
		z-index: 0;
		width: clamp(7rem, 17vw, 12.25rem);
		pointer-events: none;
	}

	.contact-methods {
		display: grid;
		gap: 0.72rem;
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.contact-method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.contact-method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.contact-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--commissions-text);
		border-radius: 0.45rem;
		background: var(--commissions-surface);
		font-weight: 700;
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.contact-chip:hover,
	.contact-chip:focus-visible {
		background: var(--commissions-text);
		color: var(--commissions-inverse);
		transform: translateY(-1px);
	}

	.contact-chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.contact-method:first-child .contact-chip svg {
		fill: currentColor;
	}

	.contact-chip rect,
	.contact-chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.commissions-footer {
		position: relative;
		background: var(--commissions-footer);
		color: var(--commissions-inverse);
	}

	.commissions-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.commissions-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.commissions-footer__wave g {
		will-change: transform;
	}

	.commissions-footer__wave path {
		fill: var(--commissions-footer);
	}

	.commissions-footer__inner {
		width: var(--commissions-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.commissions-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.commissions-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.commissions-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.commissions-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.commissions-nav a:focus-visible,
	.social-links a:focus-visible,
	.contact-chip:focus-visible,
	.commissions-footer a:focus-visible {
		outline: 2px solid var(--commissions-text);
		outline-offset: 0.28rem;
	}

	.commissions-footer a:focus-visible {
		outline-color: var(--commissions-inverse);
	}

	@media (max-width: 920px) {
		.commissions-nav {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.85rem 1.4rem;
		}

		.commissions-cta__cat {
			opacity: 0.86;
			right: 0;
		}

		.commissions-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.commissions-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--commissions-shell: min(100vw - 1.25rem, 34rem);
		}

		.commissions-header {
			padding-top: 1.4rem;
		}

		.artist-lockup {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.artist-lockup > img {
			width: 7.5rem;
		}

		.artist-lockup__topline {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.6rem 1rem;
		}

		.role-pills {
			justify-content: center;
		}

		.commissions-list {
			gap: 3.2rem;
		}

		.commissions-cta {
			min-height: 30rem;
			padding-bottom: 9rem;
		}

		.commissions-cta__cat {
			right: 50%;
			bottom: 1.35rem;
			transform: translateX(50%);
			width: 8.7rem;
		}

		.contact-method {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
		}

		.contact-method p {
			min-width: 0;
			text-align: center;
		}

		.contact-chip {
			min-height: 2.45rem;
		}

		.commissions-footer__brand,
		.commissions-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.commissions-footer__brand img {
			margin-inline: auto;
		}

		.commissions-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.commissions-nav a::after,
		.contact-chip {
			transition: none;
		}

	}
</style>
