---
import Layout from '../layouts/Layout.astro';
import ArtistHeader from '../components/ArtistHeader.astro';
import CommissionItem from '../components/CommissionItem.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { commissionItems } from '../data/commissions';
import commissionsDivider from '../assets/whiteyedcat/commissions-divider.png';
---

<Layout
	title="Commission | whiteyedcat"
	description="Commission whiteyedcat for custom portraits, pet portraits, scenery paintings, and sticker packs with country-specific rates and contact links."
>
	<main class="commissions-page">
		<ArtistHeader currentHref="/commissions" />

		<section class="commissions-section" aria-labelledby="commissions-heading">
			<div class="commissions-section__header">
				<div>
					<h2 id="commissions-heading">Commission</h2>
					<p class="page-subtitle">custom artwork made for people, pets, and places</p>
					<div class="commissions-section__currency" aria-label="Choose commission pricing currency">
						<span class="commissions-section__currency-label">Pricing</span>
						<div class="commissions-section__currency-options">
							<button type="button" data-commission-country-option="US" aria-pressed="true">USD</button>
							<button type="button" data-commission-country-option="MY" aria-pressed="false">MYR</button>
						</div>
					</div>
				</div>
			</div>
			<div class="commissions-list">
				{
					commissionItems.map((item) => (
						<CommissionItem {...item} />
					))
				}
			</div>
		</section>

		<div class="commissions-cta-wrap">
			<ContactCTA heading="Commission me!" headingId="commissions-cta-heading" dividerSrc={commissionsDivider} />
		</div>

		<SiteFooter />
	</main>
</Layout>

<style>
	:root {
		--commissions-bg: #f9f5f2;
		--commissions-surface: #ffffff;
		--commissions-text: #121212;
		--commissions-inverse: #f2eee6;
		--commissions-footer: #0b0b0b;
		--commissions-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--commissions-footer);
		--site-footer-text: var(--commissions-inverse);
		--site-footer-shell: var(--commissions-shell);
		--site-footer-focus: var(--commissions-inverse);
	}

	.commissions-page {
		min-height: 100vh;
		background: var(--commissions-surface);
		color: var(--commissions-text);
		overflow: clip;
	}

	.commissions-section {
		background: var(--commissions-surface);
		box-shadow: 0 0 0 100vmax var(--commissions-surface);
		clip-path: inset(0 -100vmax);
		width: var(--commissions-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(3.2rem, 6vw, 5.5rem);
	}

	.commissions-section__header {
		width: min(72rem, 100%);
		margin: 0 auto;
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.commissions-section__header > div {
		display: grid;
		justify-items: center;
	}

	.commissions-section h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
		text-align: center;
	}

	.commissions-section h2 {
		text-align: center;
	}

	.page-subtitle {
		margin: 0.35rem 0 0;
		font-size: clamp(0.95rem, 1.5vw, 1.25rem);
		font-weight: 500;
		line-height: 1.35;
		color: rgba(18, 18, 18, 0.72);
	}

	.commissions-section__currency {
		margin: 0.8rem 0 0;
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		max-width: 100%;
		padding: 0.25rem;
		border: 1.5px solid rgba(18, 18, 18, 0.2);
		border-radius: 999px;
		background: rgba(18, 18, 18, 0.04);
	}

	.commissions-section__currency-label {
		padding-left: 0.7rem;
		font-size: clamp(0.78rem, 1vw, 0.9rem);
		font-weight: 600;
		line-height: 1;
		color: rgba(18, 18, 18, 0.58);
	}

	.commissions-section__currency-options {
		display: inline-grid;
		grid-template-columns: repeat(2, minmax(3.25rem, 1fr));
		gap: 0.2rem;
	}

	.commissions-section__currency button {
		min-height: 2rem;
		padding: 0.3rem 0.65rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: rgba(18, 18, 18, 0.7);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
		cursor: pointer;
		transition:
			background-color 180ms ease,
			color 180ms ease;
	}

	.commissions-section__currency button:hover {
		color: var(--commissions-text);
	}

	.commissions-section__currency button[aria-pressed='true'] {
		background: var(--commissions-text);
		color: var(--commissions-inverse);
	}

	.commissions-section__currency button:focus-visible {
		outline: 2px solid var(--commissions-text);
		outline-offset: 0.2rem;
	}

	.commissions-list {
		width: min(72rem, 100%);
		margin: clamp(2.2rem, 4vw, 3.8rem) auto 0;
		display: grid;
		gap: clamp(1.2rem, 3vw, 2rem);
	}

	.commissions-cta-wrap {
		--cta-text: var(--commissions-text);
		--cta-surface: var(--commissions-surface);
		--cta-inverse: var(--commissions-inverse);
		--cta-shell: var(--commissions-shell);
		margin-bottom: 100px;
	}

	.commissions-footer {
		position: relative;
		background: var(--commissions-footer);
		color: var(--commissions-inverse);
	}

	.commissions-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.commissions-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.commissions-footer__wave g {
		will-change: transform;
	}

	.commissions-footer__wave path {
		fill: var(--commissions-footer);
	}

	.commissions-footer__inner {
		width: var(--commissions-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.commissions-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.commissions-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.commissions-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.commissions-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.commissions-footer a:focus-visible {
		outline: 2px solid var(--commissions-text);
		outline-offset: 0.28rem;
	}

	.commissions-footer a:focus-visible {
		outline-color: var(--commissions-inverse);
	}

	@media (max-width: 920px) {
		.commissions-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.commissions-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--commissions-shell: min(100vw - 1.25rem, 34rem);
		}

		.commissions-list {
			gap: 3.2rem;
		}

		.commissions-section__header {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.commissions-section h2 {
			text-align: center;
		}

		.commissions-section__currency {
			gap: 0.5rem;
		}

		.commissions-footer__brand,
		.commissions-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.commissions-footer__brand img {
			margin-inline: auto;
		}

		.commissions-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

</style>
