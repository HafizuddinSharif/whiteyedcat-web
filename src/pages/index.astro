---
import Layout from '../layouts/Layout.astro';
import AnimatedWave from '../components/AnimatedWave.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { artworkItems } from '../data/artworks';
import avatar from '../assets/whiteyedcat/avatar.png';
import cat from '../assets/whiteyedcat/cat.png';
import dividerBottom from '../assets/whiteyedcat/divider-bottom.png';
import dividerTop from '../assets/whiteyedcat/divider-top.png';
import contactFishRight from '../assets/whiteyedcat/contact-fish-right.png';
import fish from '../assets/whiteyedcat/fish.png';
import heroBg from '../assets/whiteyedcat/hero-bg.png';

const navigation = [
	{ label: 'About', href: '#about' },
	{ label: 'Artworks', href: '/artworks' },
	{ label: 'Collabs', href: '/collabs' },
	{ label: 'Commissions', href: '/commissions' },
	{ label: 'Exhibitions', href: '/exhibitions' },
	{ label: 'Contact', href: '/contact' },
];

const featuredArtworkItems = artworkItems.filter((item) => item.featured);

const rolePills = ['painter', 'illustrator'];

const vibeItems = [
	{ src: fish, alt: 'Decorative fish illustration.' },
	{ src: cat, alt: 'Decorative cat illustration.' },
];

const serviceLinks = [
	{ id: 'commissions', title: 'commissions', subtitle: 'custom artwork', href: '/commissions', corner: 'top-left' },
	{ id: 'shop', title: 'buy my arts!', subtitle: 'prints & originals', href: '/artworks', corner: 'top-right' },
	{ id: 'exhibitions', title: 'exhibitions', subtitle: 'gallery & shows', href: '/exhibitions', corner: 'bottom-left' },
	{ id: 'collabs', title: 'collaborations', subtitle: 'creative projects', href: '/collabs', corner: 'bottom-right' },
];

---

<Layout
	title="whiteyedcat | Painter and Illustrator"
	description="A responsive portfolio landing page for whiteyedcat featuring selected works, artist profile, collaborations, commissions, and contact."
>
	<div class="intro-reveal" aria-hidden="true">
		<div class="intro-reveal__brand">
			<img src={avatar.src} alt="" loading="eager" decoding="async" />
			<p>whiteyedcat</p>
		</div>
		<div class="intro-reveal__wave">
			<AnimatedWave color="var(--color-footer, #0b0b0b)" />
		</div>
	</div>
	<main class="page-shell" id="top">
		<header class="site-header">
			<div class="site-header__inner">
				<a href="#top" class="brand-mark" aria-label="Go to top">
					<img src={avatar.src} alt="" loading="eager" decoding="async" />
				</a>
				<button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</button>
				<nav class="site-nav" id="primary-navigation" aria-label="Primary">
					{
						navigation.map((item) => (
							<a href={item.href}>{item.label}</a>
						))
					}
				</nav>
			</div>
		</header>

		<section class="hero">
			<div class="hero__backdrop" aria-hidden="true">
				<img data-hero-parallax src={heroBg.src} alt="" loading="eager" decoding="async" />
			</div>
			<div class="hero__overlay" aria-hidden="true"></div>
			<div class="hero__content">
				<div class="hero__socials" aria-label="Social links">
					<a href="#contact">X</a>
					<a href="#contact">IG</a>
					<a href="#contact">@</a>
				</div>
				<h1>whiteyedcat</h1>
					<div class="role-pills" aria-label="Creative roles">
						{
							rolePills.map((role) => (
								<span class="role-pill">
									<span class="role-pills__icon" aria-hidden="true">✦</span>
									<span class="role-pill__label">{role}</span>
								</span>
							))
						}
					</div>
			</div>
		</section>

		<section class="gallery-section" id="artworks">
			<div class="section-heading">
				<h2>Featured works</h2>
			</div>
			<div class="gallery-columns" data-masonry-gallery>
				{
					featuredArtworkItems.map((item) => (
						<ArtworkCard
							src={item.src}
							alt={item.alt}
							title={item.title}
							variant={item.variant}
							purchaseUrl={item.purchaseUrl}
						/>
					))
				}
			</div>
		</section>

		<div class="divider divider--top" aria-hidden="true">
			<img src={dividerTop.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="about-section" id="about">
			<div class="about-card">
				<div class="about-card__avatar">
					<img src={avatar.src} alt="whiteyedcat illustrated profile avatar." loading="lazy" decoding="async" />
				</div>
				<div class="about-card__copy">
					<p class="eyebrow">Meet <span>whiteyedcat</span></p>
					<p class="lead">
						Exploring emotions of womanhood through my paintings, my paintings delve into a realm where playfulness dances with darkness. Through my art, I explore the depth of emotions beyond what meets the eye.
					</p>
					<div class="vibes">
						<div>
							<h3>What I vibe with</h3>
						</div>
						<div class="vibes__art">
							{
								vibeItems.map((item) => (
									<img src={item.src.src} alt={item.alt} loading="lazy" decoding="async" />
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="divider divider--bottom" aria-hidden="true">
			<img src={dividerBottom.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="services-section" id="contact">
			<div class="services-layout">
				<img class="services-layout__fish services-layout__fish--left" src={fish.src} alt="" loading="lazy" decoding="async" />
				<div class="section-heading section-heading--large">
					<h2>Work with me!</h2>
				</div>
				<ul class="services-grid" aria-label="Ways to work with whiteyedcat">
					{
						serviceLinks.map((item) => (
							<li id={item.id} class={`service-card service-card--${item.corner}`}>
								<a href={item.href}>
									<span class="spark" aria-hidden="true">✦</span>
									<span class="service-card__copy">
										<strong>{item.title}</strong>
										<span>{item.subtitle}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<img class="services-layout__fish services-layout__fish--right" src={contactFishRight.src} alt="" loading="lazy" decoding="async" />
			</div>
		</section>

		<SiteFooter variant="home" />
	</main>
</Layout>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	let frame = 0;

	const updateHeroParallax = () => {
		frame = 0;
		const hero = document.querySelector<HTMLElement>('.hero');
		const parallaxImage = document.querySelector<HTMLElement>('[data-hero-parallax]');

		if (!hero || !parallaxImage || reducedMotion.matches) {
			if (parallaxImage) {
				parallaxImage.style.setProperty('--hero-parallax-y', '0px');
			}
			return;
		}

		const rect = hero.getBoundingClientRect();
		const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

		if (rect.bottom < 0 || rect.top > viewportHeight) {
			return;
		}

		const scrollProgress = Math.min(1, Math.max(0, -rect.top / rect.height));
		const startOffset = Math.max(-120, -viewportHeight * 0.12);
		const travel = Math.min(320, Math.max(180, viewportHeight * 0.32));
		const offset = startOffset + scrollProgress * travel;

		parallaxImage.style.setProperty('--hero-parallax-y', `${offset}px`);
	};

	const requestHeroParallaxUpdate = () => {
		if (frame) return;
		frame = window.requestAnimationFrame(updateHeroParallax);
	};

	updateHeroParallax();
	window.addEventListener('scroll', requestHeroParallaxUpdate, { passive: true });
	window.addEventListener('resize', requestHeroParallaxUpdate);
	reducedMotion.addEventListener('change', requestHeroParallaxUpdate);

	const mediumScreen = window.matchMedia('(max-width: 920px)');

	const setNavigationOpen = (isOpen: boolean) => {
		const siteHeader = document.querySelector<HTMLElement>('.site-header');
		const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
		const primaryNavigation = document.querySelector<HTMLElement>('#primary-navigation');

		if (!siteHeader || !navToggle || !primaryNavigation) return;

		siteHeader.classList.toggle('is-nav-open', isOpen);
		navToggle.setAttribute('aria-expanded', String(isOpen));
		navToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
	};

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;

		const siteHeader = document.querySelector<HTMLElement>('.site-header');
		const navToggle = event.target.closest<HTMLButtonElement>('.nav-toggle');

		if (navToggle) {
			setNavigationOpen(!siteHeader?.classList.contains('is-nav-open'));
			return;
		}

		if (event.target.closest('#primary-navigation a')) {
			setNavigationOpen(false);
			return;
		}

		if (!mediumScreen.matches || !siteHeader?.classList.contains('is-nav-open')) return;
		if (siteHeader.contains(event.target)) return;

		setNavigationOpen(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			setNavigationOpen(false);
		}
	});

	mediumScreen.addEventListener('change', (event) => {
		if (!event.matches) {
			setNavigationOpen(false);
		}
	});

	const layoutArtworkMasonry = () => {
		document.querySelectorAll<HTMLElement>('[data-masonry-gallery]').forEach((gallery) => {
			const styles = window.getComputedStyle(gallery);
			const rowHeight = Number.parseFloat(styles.getPropertyValue('grid-auto-rows'));
			const rowGap = Number.parseFloat(styles.getPropertyValue('row-gap'));

			if (!rowHeight) return;

			gallery.querySelectorAll<HTMLElement>('[data-artwork-card]').forEach((card) => {
				card.style.gridRowEnd = '';
				const cardHeight = card.getBoundingClientRect().height;
				const rowSpan = Math.ceil((cardHeight + rowGap) / (rowHeight + rowGap));
				card.style.gridRowEnd = `span ${rowSpan}`;
			});
		});
	};

	let masonryFrame = 0;
	const queueArtworkMasonry = () => {
		window.cancelAnimationFrame(masonryFrame);
		masonryFrame = window.requestAnimationFrame(layoutArtworkMasonry);
	};

	window.addEventListener('load', queueArtworkMasonry);
	window.addEventListener('resize', queueArtworkMasonry);
	document.addEventListener('astro:page-load', () => {
		setNavigationOpen(false);
		requestHeroParallaxUpdate();
		queueArtworkMasonry();
	});
	document.fonts?.ready.then(queueArtworkMasonry);
	queueArtworkMasonry();
</script>

<style>
	:root {
		--color-bg: #f9f5f2;
		--color-surface: #ffffff;
		--color-text: #121212;
		--color-text-inverse: #f2eee6;
		--color-card: #ffffff;
		--color-accent: #5fd0d3;
		--color-yellow: #f6c813;
		--color-footer: #0b0b0b;
		--shadow-soft: 0 30px 80px rgba(18, 18, 18, 0.08);
		--shell-width: min(1180px, calc(100vw - 2rem));
		--section-gap: clamp(4rem, 8vw, 8rem);
		--intro-wave-height: clamp(4.5rem, 12vw, 7.5rem);
		--site-footer-bg: var(--color-footer);
		--site-footer-text: var(--color-text-inverse);
		--site-footer-wave-bg: var(--color-surface);
		--site-footer-shell: var(--shell-width);
		--site-footer-focus: var(--color-accent);
	}

	.page-shell {
		background: var(--color-surface);
		color: var(--color-text);
		overflow: clip;
	}

	.intro-reveal {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: var(--color-footer);
		backface-visibility: hidden;
		overflow: visible;
		pointer-events: auto;
		transform: translate3d(0, 0, 0);
		will-change: transform;
		animation: introRevealWipe 900ms cubic-bezier(0.76, 0, 0.24, 1) 1050ms forwards;
	}

	.intro-reveal__brand {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 0.45rem;
		color: var(--color-text-inverse);
		text-align: center;
		opacity: 0;
		animation: introBrandFade 1100ms ease forwards;
	}

	.intro-reveal__brand img {
		width: clamp(5rem, 14vw, 7.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 24px 56px rgba(0, 0, 0, 0.32);
	}

	.intro-reveal__brand p {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-size: clamp(4rem, 10vw, 7.75rem);
		line-height: 0.95;
		font-weight: 400;
	}

	.intro-reveal__wave {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(var(--intro-wave-height) * -1 + 1px);
		height: var(--intro-wave-height);
		overflow: hidden;
		transform: translate3d(0, 0, 0);
		color: var(--color-footer);
	}

	.site-header,
	.hero__content {
		opacity: 0;
		will-change: opacity;
		animation: introContentReveal 700ms ease 1240ms forwards;
	}

	@keyframes introRevealWipe {
		0% {
			transform: translate3d(0, 0, 0);
			visibility: visible;
		}

		99% {
			transform: translate3d(0, calc(100vh + var(--intro-wave-height)), 0);
			visibility: visible;
		}

		100% {
			transform: translate3d(0, calc(100vh + var(--intro-wave-height)), 0);
			visibility: hidden;
		}
	}

	@keyframes introBrandFade {
		0% {
			opacity: 0;
			transform: translate3d(0, 0.25rem, 0);
		}

		28%,
		58% {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}

		100% {
			opacity: 0;
			transform: translate3d(0, -0.35rem, 0);
		}
	}

	@keyframes introContentReveal {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 30;
		margin-bottom: 0;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(18, 18, 18, 0.08);
	}

	.site-header__inner {
		width: var(--shell-width);
		margin: 0 auto;
		min-height: 5.5rem;
		display: flex;
		align-items: center;
		/* gap: 1.25rem; */
	}

	.brand-mark {
		flex: 0 0 auto;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: 0 10px 24px rgba(18, 18, 18, 0.14);
	}

	.brand-mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.site-nav {
		flex: 1 1 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.9rem 1.35rem;
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.site-nav a {
		flex: 1 1 0;
		position: relative;
		text-align: center;
		padding-block: 0.2rem;
	}

	.site-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.15rem;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 180ms ease;
	}

	.site-nav a:hover::after,
	.site-nav a:focus-visible::after {
		transform: scaleX(1);
	}

	.nav-toggle {
		position: relative;
		display: none;
		width: 3rem;
		height: 3rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		place-items: center;
		padding: 0;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.nav-toggle:hover,
	.nav-toggle:focus-visible {
		background: transparent;
	}

	.nav-toggle span {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 1.18rem;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.nav-toggle span:nth-child(1) {
		transform: translate(-50%, calc(-50% - 0.42rem));
	}

	.nav-toggle span:nth-child(2) {
		transform: translate(-50%, -50%);
	}

	.nav-toggle span:nth-child(3) {
		transform: translate(-50%, calc(-50% + 0.42rem));
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(1) {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(3) {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	.hero {
		position: relative;
		min-height: 100vh;
		display: grid;
		place-items: end center;
		padding: 8.5rem 1rem 2.2rem;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__backdrop,
	.hero__overlay {
		position: absolute;
		inset: 0;
	}

	.hero__backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: translate3d(0, var(--hero-parallax-y, -72px), 0) scale(1.22);
		transform-origin: center top;
		will-change: transform;
	}

	.hero__overlay {
		background:
			linear-gradient(to bottom, rgba(18, 18, 18, 0.1), rgba(18, 18, 18, 0.38)),
			radial-gradient(circle at 50% 65%, rgba(255, 255, 255, 0.04), transparent 40%);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(44rem, 100%);
		display: grid;
		justify-items: center;
		gap: 0.8rem;
		color: var(--color-text-inverse);
		text-align: center;
	}

	.hero__socials {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero__content h1,
	.site-footer__brand h2 {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-size: clamp(4rem, 10vw, 7.75rem);
		line-height: 0.95;
		font-weight: 400;
	}

	.role-pills {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.9rem;
	}

	.role-pill {
		border: 1.5px solid rgba(242, 238, 230, 0.92);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 1.3rem;
		font-size: 1rem;
		font-weight: 700;
	}

	.role-pills__icon {
		font-size: 0.95rem;
		line-height: 1;
	}

	.gallery-section,
	.about-section {
		width: var(--shell-width);
		margin: 0 auto;
	}

	.gallery-section {
		padding-block: var(--section-gap);
	}

	.section-heading {
		margin-bottom: 2.2rem;
		text-align: center;
	}

	.section-heading--large {
		margin-bottom: 2.8rem;
	}

	.section-heading h2,
	.eyebrow {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
	}

	.section-heading h2 {
		font-size: clamp(2.35rem, 5vw, 4rem);
		line-height: 1;
	}

	.gallery-columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: 0.5rem;
		gap: 1.4rem;
		align-items: start;
	}

	:global(.gallery-columns .artwork-card) {
		--artwork-card-radius: 1rem;
		--artwork-card-bg: var(--color-card);
		--artwork-card-shadow: var(--shadow-soft);
		--artwork-card-title-bg: var(--color-card);
		--artwork-card-title-color: #121212;
		--artwork-card-tag: var(--color-yellow);
	}

	.divider {
		width: min(2000px, 100%);
		margin: 0 auto;
	}

	.divider img {
		width: 100%;
		height: auto;
	}

	.about-section {
		padding-block: var(--section-gap);
	}

	.about-card {
		display: grid;
		grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.about-card__avatar {
		justify-self: start;
		width: clamp(11rem, 28vw, 16rem);
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: 0 24px 54px rgba(18, 18, 18, 0.14);
	}

	.about-card__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.eyebrow {
		font-size: clamp(1.85rem, 3vw, 2.3rem);
		line-height: 1.1;
	}

	.eyebrow span {
		font-family: 'Birthstone', cursive;
		font-size: 1.25em;
	}

	.lead {
		max-width: 46rem;
		margin: 1rem 0 0;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.7;
	}

	.vibes {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 2rem;
		margin-top: 1.35rem;
	}

	.vibes h3 {
		margin: 0;
		font-size: 1.3rem;
	}

	.vibes__art {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

