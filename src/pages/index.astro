---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import avatar from '../assets/whiteyedcat/avatar.png';
import cat from '../assets/whiteyedcat/cat.png';
import dividerBottom from '../assets/whiteyedcat/divider-bottom.png';
import dividerTop from '../assets/whiteyedcat/divider-top.png';
import fish from '../assets/whiteyedcat/fish.png';
import galleryA from '../assets/whiteyedcat/gallery-a.png';
import galleryB from '../assets/whiteyedcat/gallery-b.png';
import heroBg from '../assets/whiteyedcat/hero-bg.png';
import stickers from '../assets/whiteyedcat/stickers.png';

const navigation = [
	{ label: 'About', href: '#about' },
	{ label: 'Artworks', href: '/artworks' },
	{ label: 'Collabs', href: '#collabs' },
	{ label: 'Commisions', href: '#commissions' },
	{ label: 'Exhibitions', href: '#exhibitions' },
	{ label: 'Media Mentions', href: '#media' },
	{ label: 'Contact', href: '#contact' },
];

const galleryItems = [
	{ src: galleryA, alt: 'Colorful collage artwork featuring playful objects and a dog portrait.', title: 'Artwork 1', size: 'portrait', purchaseUrl: null },
	{ src: galleryB, alt: 'Portrait painting framed by green leaves and ribbon-like accents.', title: 'Artwork 2', size: 'square', purchaseUrl: null },
	{ src: galleryA, alt: 'Mixed-media collage with bright motifs and layered stickers.', title: 'Artwork 3', size: 'portrait', purchaseUrl: null },
	{ src: galleryB, alt: 'Illustrated portrait with dark floral tones and painterly texture.', title: 'Artwork 4', size: 'square', purchaseUrl: null },
	{ src: galleryA, alt: 'Eclectic collage combining warm colors and decorative cut-outs.', title: 'Artwork 5', size: 'square', purchaseUrl: null },
	{ src: galleryB, alt: 'Painterly portrait piece with botanical framing.', title: 'Artwork 6', size: 'portrait', purchaseUrl: null },
];

const rolePills = ['painter', 'illustrator'];

const vibeItems = [
	{ src: fish, alt: 'Decorative fish illustration.' },
	{ src: cat, alt: 'Decorative cat illustration.' },
];

const serviceLinks = [
	{ id: 'collabs', label: 'collaborations', href: '#collabs' },
	{ id: 'commissions', label: 'commisions', href: '#commissions', badge: 'Accepting requests!' },
	{ id: 'exhibitions', label: 'exhibitions', href: '#exhibitions' },
	{ id: 'shop', label: 'buy my artwork!', href: '/artworks' },
];

const footerGroups = [
	[
		{ label: 'Home', href: '#top' },
		{ label: 'About', href: '#about' },
		{ label: 'Contact', href: '#contact' },
	],
	[
		{ label: 'Artworks', href: '/artworks' },
		{ label: 'Collabs', href: '#collabs' },
		{ label: 'Commisions', href: '#commissions' },
		{ label: 'Exhibitions', href: '#exhibitions' },
	],
];
---

<Layout
	title="whiteyedcat | Painter and Illustrator"
	description="A responsive portfolio landing page for whiteyedcat featuring selected works, artist profile, collaborations, commissions, and contact."
>
	<div class="intro-reveal" aria-hidden="true">
		<div class="intro-reveal__brand">
			<img src={avatar.src} alt="" loading="eager" decoding="async" />
			<p>whiteyedcat</p>
		</div>
		<div class="intro-reveal__wave">
			<svg viewBox="0 0 1440 160" preserveAspectRatio="none" focusable="false">
				<g>
					<path d="M0 108C120 50 240 50 360 108C480 166 600 166 720 108C840 50 960 50 1080 108C1200 166 1320 166 1440 108V160H0V108Z"></path>
					<path d="M1440 108C1560 50 1680 50 1800 108C1920 166 2040 166 2160 108C2280 50 2400 50 2520 108C2640 166 2760 166 2880 108V160H1440V108Z"></path>
					<animateTransform attributeName="transform" type="translate" from="-1440 0" to="0 0" dur="5s" repeatCount="indefinite"></animateTransform>
				</g>
			</svg>
		</div>
	</div>
	<main class="page-shell" id="top">
		<header class="site-header">
			<div class="site-header__inner">
				<a href="#top" class="brand-mark" aria-label="Go to top">
					<img src={avatar.src} alt="" loading="eager" decoding="async" />
				</a>
				<button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</button>
				<nav class="site-nav" id="primary-navigation" aria-label="Primary">
					{
						navigation.map((item) => (
							<a href={item.href}>{item.label}</a>
						))
					}
				</nav>
			</div>
		</header>

		<section class="hero">
			<div class="hero__backdrop" aria-hidden="true">
				<img data-hero-parallax src={heroBg.src} alt="" loading="eager" decoding="async" />
			</div>
			<div class="hero__overlay" aria-hidden="true"></div>
			<div class="hero__content">
				<div class="hero__socials" aria-label="Social links">
					<a href="#contact">X</a>
					<a href="#contact">IG</a>
					<a href="#contact">@</a>
				</div>
				<h1>whiteyedcat</h1>
					<div class="role-pills" aria-label="Creative roles">
						{
							rolePills.map((role) => (
								<span class="role-pill">
									<span class="role-pills__icon" aria-hidden="true">✦</span>
									<span class="role-pill__label">{role}</span>
								</span>
							))
						}
					</div>
			</div>
		</section>

		<section class="gallery-section" id="artworks">
			<div class="section-heading">
				<h2>Featured works</h2>
			</div>
			<div class="gallery-grid">
				<div class="gallery-grid__sizer" aria-hidden="true"></div>
				<div class="gallery-grid__gutter" aria-hidden="true"></div>
				{
					galleryItems.map((item) => (
						<ArtworkCard
							src={item.src}
							alt={item.alt}
							title={item.title}
							variant={item.size}
							purchaseUrl={item.purchaseUrl}
							class="art-card"
						/>
					))
				}
			</div>
		</section>

		<div class="divider divider--top" aria-hidden="true">
			<img src={dividerTop.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="about-section" id="about">
			<div class="about-card">
				<div class="about-card__avatar">
					<img src={avatar.src} alt="whiteyedcat illustrated profile avatar." loading="lazy" decoding="async" />
				</div>
				<div class="about-card__copy">
					<p class="eyebrow">Meet <span>whiteyedcat</span></p>
					<p class="lead">
						Exploring emotions of womanhood through my paintings, my paintings delve into a realm where playfulness dances with darkness. Through my art, I explore the depth of emotions beyond what meets the eye.
					</p>
					<div class="vibes">
						<div>
							<h3>What I vibe with</h3>
						</div>
						<div class="vibes__art">
							{
								vibeItems.map((item) => (
									<img src={item.src.src} alt={item.alt} loading="lazy" decoding="async" />
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="divider divider--bottom" aria-hidden="true">
			<img src={dividerBottom.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="services-section" id="contact">
			<div class="section-heading section-heading--large">
				<h2>Work with me!</h2>
			</div>
			<div class="services-layout">
				<div class="services-layout__art">
					<div class="services-layout__frame">
						<img src={galleryA.src} alt="Collage artwork used as a call-to-action visual." loading="lazy" decoding="async" />
						<img class="services-layout__stickers" src={stickers.src} alt="" loading="lazy" decoding="async" />
					</div>
				</div>
				<div class="services-layout__list">
					<ul>
						{
							serviceLinks.map((item) => (
								<li id={item.id} class="service-pill" >
									<a href={item.href}>
										<span class="spark" aria-hidden="true">✦</span>
										<span>{item.badge && <strong class="service-badge">{item.badge}</strong>} {item.label}</span>
									</a>
								</li>
							))
						}
					</ul>
					<div class="services-layout__media" id="media">
						<p>Media mentions and external features can live here next as the portfolio expands.</p>
					</div>
				</div>
				<img class="services-layout__accent" src={fish.src} alt="" loading="lazy" decoding="async" />
			</div>
		</section>

		<footer class="site-footer">
			<div class="site-footer__wave" aria-hidden="true">
				<svg viewBox="0 0 1440 160" preserveAspectRatio="none" focusable="false">
					<g>
						<path d="M0 108C120 50 240 50 360 108C480 166 600 166 720 108C840 50 960 50 1080 108C1200 166 1320 166 1440 108V160H0V108Z"></path>
						<path d="M1440 108C1560 50 1680 50 1800 108C1920 166 2040 166 2160 108C2280 50 2400 50 2520 108C2640 166 2760 166 2880 108V160H1440V108Z"></path>
						<animateTransform attributeName="transform" type="translate" from="-1440 0" to="0 0" dur="5s" repeatCount="indefinite"></animateTransform>
					</g>
				</svg>
			</div>
			<div class="site-footer__inner">
				<div class="site-footer__brand">
					<img src={avatar.src} alt="" loading="lazy" decoding="async" />
					<h2>whiteyedcat</h2>
					<p class="social-line">X IG @</p>
					<p class="credit">Designed and build by snouu.dev</p>
				</div>
				<div class="site-footer__links">
					{
						footerGroups.map((group) => (
							<ul>
								{
									group.map((item) => (
										<li><a href={item.href}>{item.label}</a></li>
									))
								}
							</ul>
						))
					}
				</div>
			</div>
		</footer>
	</main>
</Layout>

<script>
	import Masonry from 'masonry-layout';

	const galleryGrid = document.querySelector<HTMLElement>('.gallery-grid');

	if (galleryGrid) {
		const masonry = new Masonry(galleryGrid, {
			itemSelector: '.art-card',
			columnWidth: '.gallery-grid__sizer',
			gutter: '.gallery-grid__gutter',
			percentPosition: true,
		});

		const galleryImages = Array.from(galleryGrid.querySelectorAll('img'));

		galleryImages.forEach((image) => {
			if (image.complete) return;
			image.addEventListener('load', () => masonry.layout(), { once: true });
			image.addEventListener('error', () => masonry.layout(), { once: true });
		});

		window.addEventListener('load', () => masonry.layout(), { once: true });
		window.addEventListener('resize', () => masonry.layout(), { passive: true });
	}

	const hero = document.querySelector<HTMLElement>('.hero');
	const parallaxImage = document.querySelector<HTMLElement>('[data-hero-parallax]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	let frame = 0;

	const updateHeroParallax = () => {
		frame = 0;

		if (!hero || !parallaxImage || reducedMotion.matches) {
			if (parallaxImage) {
				parallaxImage.style.setProperty('--hero-parallax-y', '0px');
			}
			return;
		}

		const rect = hero.getBoundingClientRect();
		const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

		if (rect.bottom < 0 || rect.top > viewportHeight) {
			return;
		}

		const scrollProgress = Math.min(1, Math.max(0, -rect.top / rect.height));
		const startOffset = Math.max(-120, -viewportHeight * 0.12);
		const travel = Math.min(320, Math.max(180, viewportHeight * 0.32));
		const offset = startOffset + scrollProgress * travel;

		parallaxImage.style.setProperty('--hero-parallax-y', `${offset}px`);
	};

	const requestHeroParallaxUpdate = () => {
		if (frame) return;
		frame = window.requestAnimationFrame(updateHeroParallax);
	};

	updateHeroParallax();
	window.addEventListener('scroll', requestHeroParallaxUpdate, { passive: true });
	window.addEventListener('resize', requestHeroParallaxUpdate);
	reducedMotion.addEventListener('change', requestHeroParallaxUpdate);

	const siteHeader = document.querySelector<HTMLElement>('.site-header');
	const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const primaryNavigation = document.querySelector<HTMLElement>('#primary-navigation');
	const mediumScreen = window.matchMedia('(max-width: 920px)');

	const setNavigationOpen = (isOpen: boolean) => {
		if (!siteHeader || !navToggle || !primaryNavigation) return;

		siteHeader.classList.toggle('is-nav-open', isOpen);
		navToggle.setAttribute('aria-expanded', String(isOpen));
		navToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
	};

	navToggle?.addEventListener('click', () => {
		setNavigationOpen(!siteHeader?.classList.contains('is-nav-open'));
	});

	primaryNavigation?.addEventListener('click', (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			setNavigationOpen(false);
		}
	});

	document.addEventListener('click', (event) => {
		if (!mediumScreen.matches || !siteHeader?.classList.contains('is-nav-open')) return;
		if (event.target instanceof Node && siteHeader.contains(event.target)) return;

		setNavigationOpen(false);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			setNavigationOpen(false);
		}
	});

	mediumScreen.addEventListener('change', (event) => {
		if (!event.matches) {
			setNavigationOpen(false);
		}
	});
</script>

<style>
	:root {
		--color-bg: #f9f5f2;
		--color-text: #121212;
		--color-text-inverse: #f2eee6;
		--color-card: #ffffff;
		--color-accent: #5fd0d3;
		--color-footer: #0b0b0b;
		--shadow-soft: 0 30px 80px rgba(18, 18, 18, 0.08);
		--shell-width: min(1180px, calc(100vw - 2rem));
		--section-gap: clamp(4rem, 8vw, 8rem);
		--intro-wave-height: clamp(4.5rem, 12vw, 7.5rem);
	}

	.page-shell {
		background: var(--color-bg);
		color: var(--color-text);
		overflow: clip;
	}

	.intro-reveal {
		position: fixed;
		inset: 0;
		z-index: 100;
		background: var(--color-footer);
		backface-visibility: hidden;
		overflow: visible;
		pointer-events: auto;
		transform: translate3d(0, 0, 0);
		will-change: transform;
		animation: introRevealWipe 900ms cubic-bezier(0.76, 0, 0.24, 1) 1050ms forwards;
	}

	.intro-reveal__brand {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 0.45rem;
		color: var(--color-text-inverse);
		text-align: center;
		opacity: 0;
		animation: introBrandFade 1100ms ease forwards;
	}

	.intro-reveal__brand img {
		width: clamp(5rem, 14vw, 7.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 24px 56px rgba(0, 0, 0, 0.32);
	}

	.intro-reveal__brand p {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-size: clamp(4rem, 10vw, 7.75rem);
		line-height: 0.95;
		font-weight: 400;
	}

	.intro-reveal__wave {
		position: absolute;
		left: 0;
		right: 0;
		top: calc(var(--intro-wave-height) * -1 + 1px);
		height: var(--intro-wave-height);
		overflow: hidden;
		transform: translate3d(0, 0, 0);
	}

	.intro-reveal__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.intro-reveal__wave path {
		fill: var(--color-footer);
	}

	.site-header,
	.hero__content {
		opacity: 0;
		will-change: opacity;
		animation: introContentReveal 700ms ease 1240ms forwards;
	}

	@keyframes introRevealWipe {
		0% {
			transform: translate3d(0, 0, 0);
			visibility: visible;
		}

		99% {
			transform: translate3d(0, calc(100vh + var(--intro-wave-height)), 0);
			visibility: visible;
		}

		100% {
			transform: translate3d(0, calc(100vh + var(--intro-wave-height)), 0);
			visibility: hidden;
		}
	}

	@keyframes introBrandFade {
		0% {
			opacity: 0;
			transform: translate3d(0, 0.25rem, 0);
		}

		28%,
		58% {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}

		100% {
			opacity: 0;
			transform: translate3d(0, -0.35rem, 0);
		}
	}

	@keyframes introContentReveal {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 30;
		margin-bottom: 0;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(18, 18, 18, 0.08);
	}

	.site-header__inner {
		width: var(--shell-width);
		margin: 0 auto;
		min-height: 5.5rem;
		display: flex;
		align-items: center;
		/* gap: 1.25rem; */
	}

	.brand-mark {
		flex: 0 0 auto;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: 0 10px 24px rgba(18, 18, 18, 0.14);
	}

	.brand-mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.site-nav {
		flex: 1 1 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.9rem 1.35rem;
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.site-nav a {
		flex: 1 1 0;
		position: relative;
		text-align: center;
		padding-block: 0.2rem;
	}

	.site-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.15rem;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 180ms ease;
	}

	.site-nav a:hover::after,
	.site-nav a:focus-visible::after {
		transform: scaleX(1);
	}

	.nav-toggle {
		position: relative;
		display: none;
		width: 3rem;
		height: 3rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		place-items: center;
		padding: 0;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.nav-toggle:hover,
	.nav-toggle:focus-visible {
		background: transparent;
	}

	.nav-toggle span {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: 1.18rem;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.nav-toggle span:nth-child(1) {
		transform: translate(-50%, calc(-50% - 0.42rem));
	}

	.nav-toggle span:nth-child(2) {
		transform: translate(-50%, -50%);
	}

	.nav-toggle span:nth-child(3) {
		transform: translate(-50%, calc(-50% + 0.42rem));
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(1) {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-nav-open .nav-toggle span:nth-child(3) {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	.hero {
		position: relative;
		min-height: 100vh;
		display: grid;
		place-items: end center;
		padding: 8.5rem 1rem 2.2rem;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__backdrop,
	.hero__overlay {
		position: absolute;
		inset: 0;
	}

	.hero__backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transform: translate3d(0, var(--hero-parallax-y, -72px), 0) scale(1.22);
		transform-origin: center top;
		will-change: transform;
	}

	.hero__overlay {
		background:
			linear-gradient(to bottom, rgba(18, 18, 18, 0.1), rgba(18, 18, 18, 0.38)),
			radial-gradient(circle at 50% 65%, rgba(255, 255, 255, 0.04), transparent 40%);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(44rem, 100%);
		display: grid;
		justify-items: center;
		gap: 0.8rem;
		color: var(--color-text-inverse);
		text-align: center;
	}

	.hero__socials {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero__content h1,
	.site-footer__brand h2 {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-size: clamp(4rem, 10vw, 7.75rem);
		line-height: 0.95;
		font-weight: 400;
	}

	.role-pills {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.9rem;
	}

	.services-layout__list a {
		border: 1.5px solid rgba(242, 238, 230, 0.92);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
	}

	.role-pill {
		border: 1.5px solid rgba(242, 238, 230, 0.92);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		backdrop-filter: blur(10px);
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 1.3rem;
		font-size: 1rem;
		font-weight: 700;
	}

	.role-pills__icon {
		font-size: 0.95rem;
		line-height: 1;
	}

	.gallery-section,
	.about-section,
	.services-section {
		width: var(--shell-width);
		margin: 0 auto;
	}

	.gallery-section {
