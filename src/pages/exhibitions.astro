---
import Layout from '../layouts/Layout.astro';
import ArtistHeader from '../components/ArtistHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import artoMovement from '../assets/exhibitions/arto_movement.jpg';
import exhibitionsDivider from '../assets/exhibitions/exhibitions-divider.png';
import exhibitionsFish from '../assets/exhibitions/exhibitions-fish.png';
import journalArtFest from '../assets/exhibitions/exhibition-journal-art-fest.png';
import klIllustrationFair from '../assets/exhibitions/exhibition-kl-illustration-fair.png';
import visitorsOnly from '../assets/exhibitions/exhibition-visitors-only.png';

const exhibitions = [
	{
		title: 'KL Illustration Fair 2025',
		venue: 'GMBB | Kuala Lumpur',
		image: klIllustrationFair,
		alt: 'whiteyedcat booth display at KL Illustration Fair 2025.',
		aspectRatio: '960 / 1280',
	},
	{
		title: 'Visitors Only GrimDreamStudio 2025',
		venue: 'GMBB | Kuala Lumpur',
		image: visitorsOnly,
		alt: 'whiteyedcat standing beside displayed artwork at Visitors Only GrimDreamStudio 2025.',
		aspectRatio: '834 / 1024',
	},
	{
		title: 'Journal Art Fest Georgetown 2025',
		venue: 'Georgetown | Penang',
		image: journalArtFest,
		alt: 'whiteyedcat booth display at Journal Art Fest Georgetown 2025.',
		aspectRatio: '810 / 1080',
	},
	{
		title: 'ARTO Movement 2025',
		venue: 'Malaysia',
		image: artoMovement,
		alt: 'whiteyedcat standing beside displayed artwork at Arto Movement 2025.',
		aspectRatio: '1500 / 2000',
	},
];

---

<Layout
	title="Exhibitions | whiteyedcat"
	description="whiteyedcat exhibition history and art fair appearances, including KL Illustration Fair, Visitors Only GrimDreamStudio, Journal Art Fest Georgetown, and Arto Movement."
>
	<main class="exhibitions-page">
		<ArtistHeader currentHref="/exhibitions" />

		<section class="exhibitions-section" aria-labelledby="exhibitions-heading">
			<h2 id="exhibitions-heading">Exhibitions</h2>
			<div class="exhibitions-grid">
				{
					exhibitions.map((item) => (
						<article class="exhibition-card" style={`--exhibition-aspect-ratio: ${item.aspectRatio};`}>
							<div class="exhibition-card__image">
								<img src={item.image.src} alt={item.alt} loading="lazy" decoding="async" />
							</div>
							<div class="exhibition-card__copy">
								<h3>{item.title}</h3>
								<p>{item.venue}</p>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<div class="exhibitions-divider" aria-hidden="true">
			<img src={exhibitionsDivider.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="exhibitions-cta" aria-labelledby="exhibitions-cta-heading">
			<div class="exhibitions-cta__body">
				<h2 id="exhibitions-cta-heading">Invite me to your exhibitions</h2>
				<div class="contact-methods">
					<div class="contact-method">
						<p>Send me an email at</p>
						<a class="contact-chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
							</svg>
							<span>whiteyedcat@gmail</span>
						</a>
					</div>
					<div class="contact-method">
						<p>Or DM me on</p>
						<a class="contact-chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
								<circle cx="12" cy="12" r="3.25"></circle>
								<circle cx="16.25" cy="7.75" r="0.8"></circle>
							</svg>
							<span>@whiteyedcat</span>
						</a>
					</div>
				</div>
			</div>
			<img class="exhibitions-cta__fish" src={exhibitionsFish.src} alt="" loading="lazy" decoding="async" />
		</section>

		<SiteFooter />
	</main>
</Layout>

<style>
	:root {
		--exhibitions-bg: #f9f5f2;
		--exhibitions-surface: #ffffff;
		--exhibitions-text: #121212;
		--exhibitions-inverse: #f2eee6;
		--exhibitions-footer: #0b0b0b;
		--exhibitions-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--exhibitions-footer);
		--site-footer-text: var(--exhibitions-inverse);
		--site-footer-shell: var(--exhibitions-shell);
		--site-footer-focus: var(--exhibitions-inverse);
	}

	.exhibitions-page {
		min-height: 100vh;
		background: var(--exhibitions-surface);
		color: var(--exhibitions-text);
		overflow: clip;
	}

	.exhibitions-section {
		background: var(--exhibitions-surface);
		box-shadow: 0 0 0 100vmax var(--exhibitions-surface);
		clip-path: inset(0 -100vmax);
		width: var(--exhibitions-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(5rem, 9vw, 8rem);
	}

	.exhibitions-section h2,
	.exhibitions-cta h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
		text-align: center;
	}

	.exhibitions-grid {
		width: min(58rem, 100%);
		margin: clamp(2.2rem, 4vw, 3.8rem) auto 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2.9rem, 6vw, 5.7rem) clamp(2rem, 6vw, 4.25rem);
		align-items: start;
	}

	.exhibition-card {
		display: grid;
		gap: 1rem;
		text-align: center;
	}

	.exhibition-card__image {
		overflow: hidden;
		border-radius: 0.95rem;
		background: var(--exhibitions-bg);
		aspect-ratio: var(--exhibition-aspect-ratio);
	}

	.exhibition-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.exhibition-card__copy {
		display: grid;
		gap: 0.22rem;
	}

	.exhibition-card h3,
	.exhibition-card p {
		margin: 0;
		line-height: 1.25;
	}

	.exhibition-card h3 {
		font-size: clamp(1rem, 1.7vw, 1.5rem);
		font-weight: 700;
	}

	.exhibition-card p {
		font-size: clamp(0.92rem, 1.45vw, 1.25rem);
		font-weight: 400;
	}

	.exhibitions-divider {
		width: min(1280px, 100%);
		margin: 0 auto;
		pointer-events: none;
	}

	.exhibitions-divider img {
		width: 100%;
		height: auto;
	}

	.exhibitions-cta {
		position: relative;
		width: var(--exhibitions-shell);
		min-height: clamp(20rem, 34vw, 27rem);
		margin: 0 auto;
		margin-bottom: 100px;
		padding: clamp(3.2rem, 7vw, 6.2rem) 0 clamp(7.5rem, 14vw, 10.4rem);
		display: grid;
		place-items: center;
		text-align: center;
		isolation: isolate;
	}

	.exhibitions-cta__body {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: clamp(1rem, 2vw, 1.4rem);
	}

	.exhibitions-cta__fish {
		position: absolute;
		right: clamp(0rem, 4vw, 3rem);
		bottom: clamp(2rem, 5vw, 4.5rem);
		z-index: 0;
		width: clamp(7.5rem, 18vw, 14.9rem);
		pointer-events: none;
	}

	.contact-methods {
		display: grid;
		gap: 0.72rem;
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.contact-method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.contact-method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.contact-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--exhibitions-text);
		border-radius: 0.45rem;
		background: var(--exhibitions-surface);
		font-weight: 700;
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.contact-chip:hover,
	.contact-chip:focus-visible {
		background: var(--exhibitions-text);
		color: var(--exhibitions-inverse);
		transform: translateY(-1px);
	}

	.contact-chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.contact-method:first-child .contact-chip svg {
		fill: currentColor;
	}

	.contact-chip rect,
	.contact-chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.exhibitions-footer {
		position: relative;
		background: var(--exhibitions-footer);
		color: var(--exhibitions-inverse);
	}

	.exhibitions-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.exhibitions-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.exhibitions-footer__wave g {
		will-change: transform;
	}

	.exhibitions-footer__wave path {
		fill: var(--exhibitions-footer);
	}

	.exhibitions-footer__inner {
		width: var(--exhibitions-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.exhibitions-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.exhibitions-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.exhibitions-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.exhibitions-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.contact-chip:focus-visible,
	.exhibitions-footer a:focus-visible {
		outline: 2px solid var(--exhibitions-text);
		outline-offset: 0.28rem;
	}

	.exhibitions-footer a:focus-visible {
		outline-color: var(--exhibitions-inverse);
	}

	@media (max-width: 920px) {
		.exhibitions-grid {
			width: min(46rem, 100%);
		}

		.exhibitions-cta__fish {
			opacity: 0.86;
			right: 0;
		}

		.exhibitions-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.exhibitions-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--exhibitions-shell: min(100vw - 1.25rem, 34rem);
		}

		.exhibitions-grid {
			grid-template-columns: 1fr;
			gap: 3.2rem;
		}

		.exhibition-card {
			width: min(100%, 26rem);
			justify-self: center;
		}

		.exhibitions-cta {
			min-height: 30rem;
			padding-bottom: 9rem;
		}

		.exhibitions-cta__fish {
			right: 50%;
			bottom: 1.35rem;
			transform: translateX(50%);
			width: 9.4rem;
		}

		.contact-method {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
		}

		.contact-method p {
			min-width: 0;
			text-align: center;
		}

		.contact-chip {
			min-height: 2.45rem;
		}

		.exhibitions-footer__brand,
		.exhibitions-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.exhibitions-footer__brand img {
			margin-inline: auto;
		}

		.exhibitions-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-chip {
			transition: none;
		}

	}
</style>
