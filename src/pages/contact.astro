---
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import ArtistHeader from '../components/ArtistHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import contactDividerBottom from '../assets/whiteyedcat/contact-divider-bottom.png';
import contactDividerTop from '../assets/whiteyedcat/contact-divider-top.png';
import contactFishLeft from '../assets/whiteyedcat/contact-fish-left.png';
import contactFishRight from '../assets/whiteyedcat/contact-fish-right.png';

const homeUrl = new URL('/', Astro.site ?? Astro.url).toString();
const homeQrCode = await QRCode.toDataURL(homeUrl, {
	errorCorrectionLevel: 'H',
	margin: 2,
	width: 220,
	color: {
		dark: '#121212ff',
		light: '#ffffffff',
	},
});
---

<Layout
	title="Contact | whiteyedcat"
	description="Contact whiteyedcat by email or Instagram for art commissions, illustration collaborations, exhibition invitations, art fairs, and media enquiries."
>
	<main class="contact-page">
		<ArtistHeader currentHref="/contact" />

		<div class="contact-divider contact-divider--top" aria-hidden="true">
			<img src={contactDividerTop.src} alt="" loading="eager" decoding="async" />
		</div>

		<section class="contact-section" aria-labelledby="contact-heading">
			<div class="contact-panel">
				<img class="contact-fish contact-fish--left" src={contactFishLeft.src} alt="" loading="lazy" decoding="async" />
				<div class="contact-panel__body">
					<h2 id="contact-heading">Contact Me</h2>
					<div class="contact-methods">
						<div class="contact-method">
							<p>Send me an email at</p>
							<a class="contact-chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
								<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
									<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
								</svg>
								<span>whiteyedcat@gmail</span>
							</a>
						</div>
						<div class="contact-method">
							<p>Or DM me on</p>
							<a class="contact-chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
								<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
									<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
									<circle cx="12" cy="12" r="3.25"></circle>
									<circle cx="16.25" cy="7.75" r="0.8"></circle>
								</svg>
								<span>@whiteyedcat</span>
							</a>
						</div>
					</div>
					<a class="home-qr" href={homeUrl} aria-label="Open the whiteyedcat homepage">
						<span>Scan to open whiteyedcat</span>
						<img src={homeQrCode} alt="QR code linking to the whiteyedcat homepage." loading="eager" decoding="async" />
					</a>
				</div>
				<img class="contact-fish contact-fish--right" src={contactFishRight.src} alt="" loading="lazy" decoding="async" />
			</div>
		</section>

		<div class="contact-divider contact-divider--bottom" aria-hidden="true">
			<img src={contactDividerBottom.src} alt="" loading="lazy" decoding="async" />
		</div>

		<SiteFooter />
	</main>
</Layout>

<style>
	:root {
		--contact-bg: #f9f5f2;
		--contact-surface: #ffffff;
		--contact-text: #121212;
		--contact-inverse: #f2eee6;
		--contact-footer: #0b0b0b;
		--contact-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--contact-footer);
		--site-footer-text: var(--contact-inverse);
		--site-footer-shell: var(--contact-shell);
		--site-footer-focus: var(--contact-inverse);
	}

	.contact-page {
		min-height: 100vh;
		background: var(--contact-surface);
		color: var(--contact-text);
		overflow: clip;
	}

	.contact-section {
		position: relative;
		background: var(--contact-surface);
		padding: clamp(1.8rem, 4vw, 3.7rem) 0 0;
	}

	.contact-divider {
		width: min(2000px, 100%);
		margin-inline: auto;
		pointer-events: none;
	}

	.contact-divider img {
		width: 100%;
		height: auto;
	}

	.contact-divider--top {
		margin-top: clamp(4.6rem, 8vw, 7.2rem);
	}

	.contact-divider--bottom {
		margin-top: clamp(2.4rem, 4vw, 3.8rem);
		margin-bottom: clamp(5.5rem, 11vw, 8.4rem);
	}

	.contact-panel {
		position: relative;
		width: var(--contact-shell);
		min-height: clamp(25rem, 39vw, 31rem);
		margin: 0 auto;
		display: grid;
		place-items: center;
		isolation: isolate;
	}

	.contact-panel__body {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: clamp(1rem, 2vw, 1.4rem);
		text-align: center;
	}

	.contact-panel h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		line-height: 1;
	}

	.contact-methods {
		display: grid;
		gap: 0.72rem;
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.contact-method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.contact-method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.contact-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--contact-text);
		border-radius: 0.45rem;
		background: var(--contact-surface);
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.contact-chip:hover,
	.contact-chip:focus-visible {
		background: var(--contact-text);
		color: var(--contact-inverse);
		transform: translateY(-1px);
	}

	.contact-chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.contact-method:first-child .contact-chip svg {
		fill: currentColor;
	}

	.contact-chip rect,
	.contact-chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.home-qr {
		display: grid;
		justify-items: center;
		gap: 0.7rem;
		margin-top: clamp(0.35rem, 1vw, 0.8rem);
		color: var(--contact-text);
		font-size: clamp(0.78rem, 1.2vw, 0.92rem);
		font-weight: 700;
		line-height: 1.2;
	}

	.home-qr img {
		width: clamp(8.75rem, 16vw, 13.75rem);
		aspect-ratio: 1;
		padding: 0.45rem;
		border: 1.5px solid var(--contact-text);
		border-radius: 0.45rem;
		background: var(--contact-surface);
		box-shadow: 0 18px 44px rgba(18, 18, 18, 0.08);
		transition: transform 180ms ease;
	}

	.home-qr:hover img,
	.home-qr:focus-visible img {
		transform: translateY(-1px);
	}

	.contact-fish {
		position: absolute;
		z-index: 0;
		width: clamp(8.5rem, 18vw, 15rem);
		pointer-events: none;
	}

	.contact-fish--left {
		left: clamp(0rem, 4vw, 3rem);
		top: 10%;
	}

	.contact-fish--right {
		right: clamp(0rem, 3vw, 2.6rem);
		top: 27%;
	}

	.contact-footer {
		position: relative;
		margin-top: 2rem;
		background: var(--contact-footer);
		color: var(--contact-inverse);
	}

	.contact-footer__wave {
		position: relative;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: var(--contact-surface);
		overflow: hidden;
	}

	.contact-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.contact-footer__wave g {
		will-change: transform;
	}

	.contact-footer__wave path {
		fill: var(--contact-footer);
	}

	.contact-footer__inner {
		width: var(--contact-shell);
		margin: 0 auto;
		padding: 2.5rem 0 3.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
	}

	.contact-footer__brand img {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
	}

	.contact-footer__brand h2 {
		font-size: clamp(3rem, 7vw, 5rem);
		color: var(--contact-inverse);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 0.4rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.credit {
		margin-top: 1rem;
		color: rgba(242, 238, 230, 0.82);
		font-size: 0.85rem;
	}

	.contact-footer__links {
		display: flex;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: end;
	}

	.contact-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.85rem;
		font-size: 0.92rem;
		font-weight: 700;
	}

	.contact-chip:focus-visible,
	.home-qr:focus-visible,
	.contact-footer a:focus-visible {
		outline: 2px solid var(--contact-text);
		outline-offset: 0.28rem;
	}

	.contact-chip:focus-visible {
		outline-color: var(--contact-text);
	}

	.contact-footer a:focus-visible {
		outline-color: var(--contact-inverse);
	}

	@media (max-width: 920px) {
		.contact-panel {
			min-height: 33rem;
		}

		.contact-fish {
			opacity: 0.82;
		}

		.contact-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.contact-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--contact-shell: min(100vw - 1.25rem, 34rem);
		}

		.contact-divider--top {
			margin-top: 3rem;
		}

		.contact-panel {
			min-height: 34rem;
		}

		.contact-method {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
		}

		.contact-method p {
			min-width: 0;
			text-align: center;
		}

		.contact-chip {
			min-height: 2.45rem;
		}

		.home-qr img {
			width: clamp(9.5rem, 48vw, 12rem);
		}

		.contact-fish {
			width: clamp(7rem, 38vw, 10rem);
		}

		.contact-fish--left {
			left: -1rem;
			top: 0;
		}

		.contact-fish--right {
			right: -1.35rem;
			top: auto;
			bottom: 0.4rem;
		}

		.contact-footer__brand,
		.contact-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.contact-footer__brand img {
			margin-inline: auto;
		}

		.contact-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-chip,
		.home-qr img {
			transition: none;
		}

	}
</style>
