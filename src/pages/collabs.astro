---
import Layout from '../layouts/Layout.astro';
import ArtistHeader from '../components/ArtistHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import collabBand from '../assets/whiteyedcat/collab-band.png';
import collabCat from '../assets/whiteyedcat/collab-cat.png';
import collabCover from '../assets/whiteyedcat/collab-cover.png';
import collabDivider from '../assets/whiteyedcat/collab-divider.png';

const collaborations = [
	{
		title: 'Mossery X WhiteyedCat',
		meta: 'Book Cover | 2024',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		image: collabCover,
		alt: 'Colorful illustrated book cover artwork featuring cats, bright stickers, and layered handwritten details.',
		tag: 'illustration',
	},
	{
		title: 'CelcomDigi Hari Raya Card',
		meta: 'Festivities money packet | 2025',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		image: collabCover,
		alt: 'Colorful illustrated card artwork with cats and festive graphic details.',
		tag: 'illustration',
	},
	{
		title: 'Deleted (Malaysian-based band)',
		meta: '',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		image: collabBand,
		alt: 'Painterly portrait artwork for a Malaysian-based band collaboration.',
		tag: 'illustration',
	},
];

---

<Layout
	title="Collaborations | whiteyedcat"
	description="See whiteyedcat illustration collaborations for book covers, festive artwork, music projects, and creative brand commissions."
>
	<main class="collabs-page">
		<ArtistHeader currentHref="/collabs" />

		<section class="collabs-section" aria-labelledby="collabs-heading">
			<h2 id="collabs-heading">Collaboration</h2>
			<div class="collabs-list">
				{
					collaborations.map((collab) => (
						<article class="collab-item">
							<div class="collab-item__image">
								<img src={collab.image.src} alt={collab.alt} loading="lazy" decoding="async" />
							</div>
							<div class="collab-item__copy">
								<h3>{collab.title}</h3>
								{collab.meta && <p class="collab-item__meta">{collab.meta}</p>}
								<p>{collab.description}</p>
								<span class="collab-tag">{collab.tag}</span>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<div class="collabs-divider" aria-hidden="true">
			<img src={collabDivider.src} alt="" loading="lazy" decoding="async" />
		</div>

		<section class="collabs-cta" aria-labelledby="collabs-cta-heading">
			<div class="collabs-cta__lockup">
				<img src={collabCat.src} alt="" loading="lazy" decoding="async" />
				<h2 id="collabs-cta-heading">Want to collaborate with me?</h2>
			</div>
			<div class="contact-methods">
				<div class="contact-method">
					<p>Send me an email at</p>
					<a class="contact-chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
						<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
							<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
						</svg>
						<span>whiteyedcat@gmail</span>
					</a>
				</div>
				<div class="contact-method">
					<p>Or DM me on</p>
					<a class="contact-chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
						<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
							<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
							<circle cx="12" cy="12" r="3.25"></circle>
							<circle cx="16.25" cy="7.75" r="0.8"></circle>
						</svg>
						<span>@whiteyedcat</span>
					</a>
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>

<style>
	:root {
		--collabs-bg: #f9f5f2;
		--collabs-surface: #ffffff;
		--collabs-text: #121212;
		--collabs-inverse: #f2eee6;
		--collabs-footer: #0b0b0b;
		--collabs-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--collabs-footer);
		--site-footer-text: var(--collabs-inverse);
		--site-footer-shell: var(--collabs-shell);
		--site-footer-focus: var(--collabs-inverse);
	}

	.collabs-page {
		min-height: 100vh;
		background: var(--collabs-surface);
		color: var(--collabs-text);
		overflow: clip;
	}

	.collabs-section {
		background: var(--collabs-surface);
		box-shadow: 0 0 0 100vmax var(--collabs-surface);
		clip-path: inset(0 -100vmax);
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(4.5rem, 7vw, 5.8rem);
	}

	.collabs-section h2,
	.collabs-cta h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
		text-align: center;
	}

	.collabs-list {
		display: grid;
		gap: clamp(3.8rem, 7vw, 7.2rem);
		margin-top: clamp(1.7rem, 4vw, 3.2rem);
	}

	.collab-item {
		display: grid;
		grid-template-columns: clamp(14rem, 28vw, 20.5rem) minmax(0, 1fr);
		align-items: start;
		gap: clamp(2rem, 5vw, 4.4rem);
	}

	.collab-item__image {
		aspect-ratio: 328 / 344;
		border-radius: 0.95rem;
		overflow: hidden;
		background: var(--collabs-bg);
	}

	.collab-item__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.collab-item__copy {
		display: grid;
		justify-items: start;
		gap: 0.65rem;
		padding-top: clamp(0.2rem, 1vw, 0.8rem);
	}

	.collab-item h3 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
		font-weight: 700;
	}

	.collab-item__meta,
	.collab-item__copy > p {
		margin: 0;
		font-weight: 700;
		line-height: 1.35;
	}

	.collab-item__meta {
		font-size: clamp(0.95rem, 1.5vw, 1.5rem);
	}

	.collab-item__copy > p:not(.collab-item__meta) {
		max-width: 49rem;
		font-size: clamp(0.95rem, 1.5vw, 1.5rem);
		font-weight: 500;
		text-align: justify;
	}

	.collab-tag {
		min-width: clamp(9.5rem, 20vw, 15.75rem);
		display: inline-flex;
		justify-content: center;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.2rem 1.25rem;
		border: 1.5px solid var(--collabs-text);
		border-radius: 999px;
		font-size: clamp(0.9rem, 1.35vw, 1.5rem);
		font-weight: 700;
		line-height: 1;
	}

	.collabs-divider {
		position: relative;
		z-index: 1;
		width: min(100rem, 100%);
		margin: clamp(-1rem, -1vw, -0.4rem) auto 0;
		pointer-events: none;
	}

	.collabs-divider img {
		width: 100%;
		height: auto;
	}

	.collabs-cta {
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(2.4rem, 5vw, 4.6rem) 0 clamp(8rem, 14vw, 11rem);
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.collabs-cta__lockup {
		width: fit-content;
		max-width: 100%;
		display: grid;
		justify-items: end;
	}

	.collabs-cta__lockup > img {
		width: clamp(7rem, 18vw, 13.7rem);
		aspect-ratio: 1;
		object-fit: contain;
		margin-bottom: clamp(0.8rem, 2vw, 1.4rem);
	}

	.contact-methods {
		display: grid;
		gap: 0.72rem;
		margin-top: 1.2rem;
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.contact-method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.contact-method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.contact-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--collabs-text);
		border-radius: 0.45rem;
		background: var(--collabs-surface);
		font-weight: 700;
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.contact-chip:hover,
	.contact-chip:focus-visible {
		background: var(--collabs-text);
		color: var(--collabs-inverse);
		transform: translateY(-1px);
	}

	.contact-chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.contact-method:first-child .contact-chip svg {
		fill: currentColor;
	}

	.contact-chip rect,
	.contact-chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.collabs-footer {
		position: relative;
		background: var(--collabs-footer);
		color: var(--collabs-inverse);
	}

	.collabs-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.collabs-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.collabs-footer__wave g {
		will-change: transform;
	}

	.collabs-footer__wave path {
		fill: var(--collabs-footer);
	}

	.collabs-footer__inner {
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.collabs-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.collabs-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.collabs-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.collabs-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.contact-chip:focus-visible,
	.collabs-footer a:focus-visible {
		outline: 2px solid var(--collabs-text);
		outline-offset: 0.28rem;
	}

	.collabs-footer a:focus-visible {
		outline-color: var(--collabs-inverse);
	}

	@media (max-width: 920px) {
		.collab-item {
			grid-template-columns: minmax(11rem, 16rem) minmax(0, 1fr);
			gap: 1.5rem;
		}

		.collabs-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.collabs-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--collabs-shell: min(100vw - 1.25rem, 34rem);
		}

		.collabs-list {
			gap: 3.2rem;
		}

		.collab-item {
			grid-template-columns: 1fr;
			gap: 1.1rem;
		}

		.collab-item__image {
			width: min(100%, 20.5rem);
			justify-self: center;
		}

		.collab-item__copy {
			justify-items: center;
			text-align: center;
		}

		.collab-item__copy > p:not(.collab-item__meta) {
			text-align: center;
		}

		.contact-method {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
		}

		.contact-method p {
			min-width: 0;
			text-align: center;
		}

		.contact-chip {
			min-height: 2.45rem;
		}

		.collabs-footer__brand,
		.collabs-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.collabs-footer__brand img {
			margin-inline: auto;
		}

		.collabs-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-chip {
			transition: none;
		}

	}
</style>
