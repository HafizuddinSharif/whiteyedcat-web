---
import Layout from '../layouts/Layout.astro';
import ArtistHeader from '../components/ArtistHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import celcomdigiFull from '../assets/collaborations/celcomdigi_full.webp';
import celcomdigiPacket from '../assets/collaborations/celcomdigi_packet.png';
import deletedBand from '../assets/collaborations/d_eleted_band.webp';
import deletedSpotify from '../assets/collaborations/d_leted_spotify.webp';
import mosseryCover from '../assets/collaborations/mossery_cover.png';
import mosseryFull from '../assets/collaborations/mossery_full.webp';
import mosseryPic from '../assets/collaborations/mossery_pic.webp';

const collaborations = [
	{
		title: 'Mossery X WhiteyedCat',
		meta: 'Book Cover | 2024',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		images: [
			{
				src: mosseryCover,
				alt: 'Square Mossery cover artwork by whiteyedcat with colorful cats and layered illustrated details.',
			},
			{
				src: mosseryPic,
				alt: 'Mossery collaboration product photo showing whiteyedcat artwork on a physical book cover.',
			},
			{
				src: mosseryFull,
				alt: 'Full vertical Mossery cover illustration by whiteyedcat with cats and expressive hand-drawn details.',
			},
		],
		tag: 'illustration',
	},
	{
		title: 'CelcomDigi Hari Raya Card',
		meta: 'Festivities money packet | 2025',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		images: [
			{
				src: celcomdigiPacket,
				alt: 'CelcomDigi festive money packet artwork by whiteyedcat with illustrated characters and Hari Raya details.',
			},
			{
				src: celcomdigiFull,
				alt: 'Wide CelcomDigi Hari Raya collaboration illustration by whiteyedcat with festive gathering artwork.',
			},
		],
		tag: 'illustration',
	},
	{
		title: 'Deleted (Malaysian-based band)',
		meta: '',
		description:
			'Probably some text to talk about the project and the inspiration behind the artwork id. Probably some text to talk about the project and the inspiration behind the artwork idk. Probably some text to talk about the project and the inspiration behind the artwork idk',
		images: [
			{
				src: deletedBand,
				alt: 'Painterly portrait artwork for Deleted, a Malaysian-based band collaboration.',
			},
			{
				src: deletedSpotify,
				alt: 'Deleted band collaboration artwork presented in a Spotify-style vertical layout.',
			},
		],
		tag: 'illustration',
	},
];

---

<Layout
	title="Collaborations | whiteyedcat"
	description="See whiteyedcat illustration collaborations for book covers, festive artwork, music projects, and creative brand commissions."
>
	<main class="collabs-page">
		<ArtistHeader currentHref="/collabs" />

		<section class="collabs-section" aria-labelledby="collabs-heading">
			<h2 id="collabs-heading">Collaboration</h2>
			<div class="collabs-list">
				{
					collaborations.map((collab) => (
						<article class="collab-item">
							<div class="collab-gallery" aria-label={`${collab.title} artwork gallery`}>
								<div class="collab-gallery__stage">
									{collab.images.map((image, index) => (
										<figure class:list={['collab-gallery__slide', index === 0 && 'is-active']} hidden={index !== 0}>
											<img src={image.src.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
										</figure>
									))}
								</div>
								{collab.images.length > 1 && (
									<div class="collab-gallery__footer">
										<button class="collab-gallery__arrow" type="button" data-gallery-prev aria-label={`Show previous ${collab.title} image`}>
											<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
												<path d="m15 18-6-6 6-6"></path>
											</svg>
										</button>
										<div class="collab-gallery__dots" aria-label={`${collab.title} image selector`}>
											{collab.images.map((image, index) => (
												<button
													class:list={['collab-gallery__dot', index === 0 && 'is-active']}
													type="button"
													data-gallery-dot={index}
													aria-label={`Show image ${index + 1} of ${collab.images.length}: ${image.alt}`}
													aria-current={index === 0 ? 'true' : undefined}
												></button>
											))}
										</div>
										<p class="collab-gallery__count" aria-live="polite">
											<span data-gallery-current>1</span> / {collab.images.length}
										</p>
										<button class="collab-gallery__arrow" type="button" data-gallery-next aria-label={`Show next ${collab.title} image`}>
											<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
												<path d="m9 6 6 6-6 6"></path>
											</svg>
										</button>
									</div>
								)}
							</div>
							<div class="collab-item__copy">
								<h3>{collab.title}</h3>
								{collab.meta && <p class="collab-item__meta">{collab.meta}</p>}
								<p>{collab.description}</p>
								<span class="collab-tag">{collab.tag}</span>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="collabs-cta" aria-labelledby="collabs-cta-heading">
			<div class="collabs-cta__lockup">
				<h2 id="collabs-cta-heading">Collaborate with me!</h2>
			</div>
			<div class="contact-methods">
				<div class="contact-method">
					<p>Send me an email at</p>
					<a class="contact-chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
						<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
							<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
						</svg>
						<span>whiteyedcat@gmail</span>
					</a>
				</div>
				<div class="contact-method">
					<p>Or DM me on</p>
					<a class="contact-chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
						<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
							<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
							<circle cx="12" cy="12" r="3.25"></circle>
							<circle cx="16.25" cy="7.75" r="0.8"></circle>
						</svg>
						<span>@whiteyedcat</span>
					</a>
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>

<script>
	const setupCollabGalleries = () => {
		const galleries = document.querySelectorAll<HTMLElement>('.collab-gallery');

		galleries.forEach((gallery) => {
			if (gallery.dataset.galleryReady === 'true') {
				return;
			}

			const slides = [...gallery.querySelectorAll<HTMLElement>('.collab-gallery__slide')];
			const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]')];
			const previousButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
			const nextButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
			const currentLabel = gallery.querySelector<HTMLElement>('[data-gallery-current]');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let animationTimer: number | undefined;
			let activeIndex = Math.max(
				0,
				slides.findIndex((slide) => slide.classList.contains('is-active')),
			);

			const showSlide = (nextIndex: number, direction = 1) => {
				const previousIndex = activeIndex;
				const nextActiveIndex = (nextIndex + slides.length) % slides.length;

				if (nextActiveIndex === previousIndex || slides.length === 0) {
					return;
				}

				window.clearTimeout(animationTimer);
				activeIndex = nextActiveIndex;
				gallery.dataset.slideDirection = direction > 0 ? 'next' : 'prev';

				slides.forEach((slide, index) => {
					const isActive = index === activeIndex;
					const isPrevious = index === previousIndex;
					slide.classList.toggle('is-leaving', !reduceMotion && isPrevious);
					slide.classList.toggle('is-active', isActive);
					if (isActive || (!reduceMotion && isPrevious)) {
						slide.removeAttribute('hidden');
					} else {
						slide.setAttribute('hidden', '');
					}
				});

				dots.forEach((dot, index) => {
					const isActive = index === activeIndex;
					dot.classList.toggle('is-active', isActive);
					if (isActive) {
						dot.setAttribute('aria-current', 'true');
					} else {
						dot.removeAttribute('aria-current');
					}
				});

				if (currentLabel) {
					currentLabel.textContent = String(activeIndex + 1);
				}

				if (!reduceMotion) {
					animationTimer = window.setTimeout(() => {
						slides.forEach((slide, index) => {
							slide.classList.remove('is-leaving');
							if (index !== activeIndex) {
								slide.setAttribute('hidden', '');
							}
						});
					}, 360);
				}
			};

			previousButton?.addEventListener('click', () => showSlide(activeIndex - 1, -1));
			nextButton?.addEventListener('click', () => showSlide(activeIndex + 1, 1));

			dots.forEach((dot) => {
				dot.addEventListener('click', () => {
					const index = Number(dot.dataset.galleryDot);
					showSlide(index, index > activeIndex ? 1 : -1);
				});
			});

			slides.forEach((slide, index) => {
				slide.classList.toggle('is-active', index === activeIndex);
				if (index === activeIndex) {
					slide.removeAttribute('hidden');
				} else {
					slide.setAttribute('hidden', '');
				}
			});
			gallery.dataset.galleryReady = 'true';
		});
	};

	setupCollabGalleries();
	document.addEventListener('astro:page-load', setupCollabGalleries);
</script>

<style>
	:root {
		--collabs-bg: #f9f5f2;
		--collabs-surface: #ffffff;
		--collabs-text: #121212;
		--collabs-inverse: #f2eee6;
		--collabs-footer: #0b0b0b;
		--collabs-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--collabs-footer);
		--site-footer-text: var(--collabs-inverse);
		--site-footer-shell: var(--collabs-shell);
		--site-footer-focus: var(--collabs-inverse);
	}

	.collabs-page {
		min-height: 100vh;
		background: var(--collabs-surface);
		color: var(--collabs-text);
		overflow: clip;
	}

	.collabs-section {
		background: var(--collabs-surface);
		box-shadow: 0 0 0 100vmax var(--collabs-surface);
		clip-path: inset(0 -100vmax);
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(4.5rem, 7vw, 5.8rem);
	}

	.collabs-section h2,
	.collabs-cta h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
		text-align: center;
	}

	.collabs-list {
		display: grid;
		gap: clamp(3.8rem, 7vw, 7.2rem);
		margin-top: clamp(1.7rem, 4vw, 3.2rem);
	}

	.collab-item {
		display: grid;
		grid-template-columns: clamp(18rem, 34vw, 28rem) minmax(0, 1fr);
		align-items: start;
		gap: clamp(2rem, 5vw, 4.4rem);
	}

	.collab-gallery {
		display: grid;
		gap: 0.78rem;
	}

	.collab-gallery__stage {
		position: relative;
		aspect-ratio: 328 / 344;
		border: 1.5px solid rgba(18, 18, 18, 0.12);
		border-radius: 0.95rem;
		overflow: hidden;
		background: var(--collabs-bg);
		isolation: isolate;
	}

	.collab-gallery__slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		transform: translateX(0);
		pointer-events: none;
	}

	.collab-gallery__slide[hidden] {
		display: none;
	}

	.collab-gallery__slide.is-active {
		opacity: 1;
		pointer-events: auto;
		z-index: 2;
	}

	.collab-gallery[data-slide-direction='next'] .collab-gallery__slide.is-active {
		animation: collabSlideInNext 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.collab-gallery[data-slide-direction='next'] .collab-gallery__slide.is-leaving {
		animation: collabSlideOutNext 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
		z-index: 1;
	}

	.collab-gallery[data-slide-direction='prev'] .collab-gallery__slide.is-active {
		animation: collabSlideInPrev 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.collab-gallery[data-slide-direction='prev'] .collab-gallery__slide.is-leaving {
		animation: collabSlideOutPrev 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
		z-index: 1;
	}

	.collab-gallery__slide img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	@keyframes collabSlideInNext {
		from {
			opacity: 0;
			transform: translateX(18%);
		}

		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes collabSlideOutNext {
		from {
			opacity: 1;
			transform: translateX(0);
		}

		to {
			opacity: 0;
			transform: translateX(-18%);
		}
	}

	@keyframes collabSlideInPrev {
		from {
			opacity: 0;
			transform: translateX(-18%);
		}

		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes collabSlideOutPrev {
		from {
			opacity: 1;
			transform: translateX(0);
		}

		to {
			opacity: 0;
			transform: translateX(18%);
		}
	}

	.collab-gallery__arrow {
		width: 2.25rem;
		aspect-ratio: 1;
		display: inline-grid;
		place-items: center;
		border: 1.5px solid var(--collabs-text);
		border-radius: 50%;
		background: var(--collabs-surface);
		color: var(--collabs-text);
		cursor: pointer;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.collab-gallery__arrow:hover,
	.collab-gallery__arrow:focus-visible {
		background: var(--collabs-text);
		color: var(--collabs-inverse);
		transform: translateY(-1px);
	}

	.collab-gallery__arrow svg {
		width: 1.35rem;
		height: 1.35rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.collab-gallery__footer {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 0.68rem;
	}

	.collab-gallery__dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
	}

	.collab-gallery__dot {
		width: 0.62rem;
		aspect-ratio: 1;
		padding: 0;
		border: 1.5px solid var(--collabs-text);
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
		transition:
			background-color 180ms ease,
			transform 180ms ease;
	}

	.collab-gallery__dot:hover,
	.collab-gallery__dot:focus-visible,
	.collab-gallery__dot.is-active {
		background: var(--collabs-text);
		transform: scale(1.12);
	}

	.collab-gallery__count {
		margin: 0;
		min-width: 2.25rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1;
		text-align: right;
	}

	.collab-item__copy {
		display: grid;
		justify-items: start;
		gap: 0.65rem;
		padding-top: clamp(0.2rem, 1vw, 0.8rem);
	}

	.collab-item h3 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
		font-weight: 700;
	}

	.collab-item__meta,
	.collab-item__copy > p {
		margin: 0;
		font-weight: 700;
		line-height: 1.35;
	}

	.collab-item__meta {
		font-size: clamp(0.95rem, 1.5vw, 1.5rem);
	}

	.collab-item__copy > p:not(.collab-item__meta) {
		max-width: 49rem;
		font-size: clamp(0.95rem, 1.5vw, 1.5rem);
		font-weight: 500;
		text-align: justify;
	}

	.collab-tag {
		min-width: clamp(9.5rem, 20vw, 15.75rem);
		display: inline-flex;
		justify-content: center;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.2rem 1.25rem;
		border: 1.5px solid var(--collabs-text);
		border-radius: 999px;
		font-size: clamp(0.9rem, 1.35vw, 1.5rem);
		font-weight: 700;
		line-height: 1;
	}

	.collabs-cta {
		border-top: 1.5px solid rgba(18, 18, 18, 0.16);
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(3rem, 6vw, 5.2rem) 0 clamp(8rem, 14vw, 11rem);
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.collabs-cta__lockup {
		width: fit-content;
		max-width: 100%;
		display: grid;
		justify-items: center;
	}

	.contact-methods {
		display: grid;
		gap: 0.72rem;
		margin-top: 1.2rem;
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.contact-method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.contact-method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.contact-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--collabs-text);
		border-radius: 0.45rem;
		background: var(--collabs-surface);
		font-weight: 700;
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.contact-chip:hover,
	.contact-chip:focus-visible {
		background: var(--collabs-text);
		color: var(--collabs-inverse);
		transform: translateY(-1px);
	}

	.contact-chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.contact-method:first-child .contact-chip svg {
		fill: currentColor;
	}

	.contact-chip rect,
	.contact-chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.collabs-footer {
		position: relative;
		background: var(--collabs-footer);
		color: var(--collabs-inverse);
	}

	.collabs-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.collabs-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.collabs-footer__wave g {
		will-change: transform;
	}

	.collabs-footer__wave path {
		fill: var(--collabs-footer);
	}

	.collabs-footer__inner {
		width: var(--collabs-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.collabs-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.collabs-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.collabs-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.collabs-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.contact-chip:focus-visible,
	.collab-gallery__arrow:focus-visible,
	.collab-gallery__dot:focus-visible,
	.collabs-footer a:focus-visible {
		outline: 2px solid var(--collabs-text);
		outline-offset: 0.28rem;
	}

	.collabs-footer a:focus-visible {
		outline-color: var(--collabs-inverse);
	}

	@media (max-width: 920px) {
		.collab-item {
			grid-template-columns: minmax(11rem, 16rem) minmax(0, 1fr);
			gap: 1.5rem;
		}

		.collabs-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.collabs-footer__links {
			max-width: 30rem;
		}
	}

