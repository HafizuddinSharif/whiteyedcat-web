---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { artworkItems } from '../data/artworks';
import avatar from '../assets/whiteyedcat/avatar.png';
import cat from '../assets/whiteyedcat/cat.png';
import contactDividerTop from '../assets/whiteyedcat/contact-divider-top.png';

const navigation = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/#about' },
	{ label: 'Artworks', href: '/artworks' },
	{ label: 'Collabs', href: '/collabs' },
	{ label: 'Commissions', href: '/commissions' },
	{ label: 'Exhibitions', href: '/exhibitions' },
	{ label: 'Contact', href: '/contact' },
];

---

<Layout
	title="Artwork | whiteyedcat"
	description="Browse selected whiteyedcat paintings, illustrations, art prints, and available original artwork including Found You, A Day of Leisure, and Making Room."
>
	<main class="artwork-page">
		<header class="artwork-header">
			<div class="artist-lockup">
				<img src={avatar.src} alt="whiteyedcat illustrated profile avatar." loading="eager" decoding="async" />
				<div class="artist-lockup__copy">
					<div class="artist-lockup__topline">
						<h1>whiteyedcat</h1>
						<div class="social-links" aria-label="Social links">
							<a href="/#contact">X</a>
							<a href="/#contact" aria-label="Instagram">
								<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
									<rect x="5" y="5" width="14" height="14" rx="4"></rect>
									<circle cx="12" cy="12" r="3.2"></circle>
									<circle cx="16.3" cy="7.7" r="0.8"></circle>
								</svg>
							</a>
							<a href="/#contact" aria-label="Threads">@</a>
						</div>
					</div>
					<div class="role-pills" aria-label="Creative roles">
						<span class="role-pill">
							<span aria-hidden="true">✦</span>
							painter
						</span>
						<span class="role-pill">
							<span aria-hidden="true">✦</span>
							illustrator
						</span>
					</div>
					<p>I live for garage survival...and cats</p>
				</div>
			</div>

			<nav class="artwork-nav" aria-label="Primary">
				{
					navigation.map((item) => (
						<a href={item.href} aria-current={item.href === '/artworks' ? 'page' : undefined}>{item.label}</a>
					))
				}
			</nav>
		</header>

		<section class="artwork-gallery" aria-labelledby="artwork-heading">
			<div class="gallery-heading">
				<h2 id="artwork-heading">Artwork</h2>
				<p>
					you can buy my artwork with the
					<span class="inline-buy">
						<button class="buy-button" type="button" disabled aria-label="Artwork purchase link unavailable">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V5.5a2.7 2.7 0 0 1 2.7-2.7H12c.5 0 1 .2 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8ZM7.2 8.7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path>
							</svg>
							<span>buy me</span>
						</button>
					</span>
					logo
				</p>
			</div>

			<div class="gallery-columns" data-masonry-gallery>
				{
					artworkItems.map((item) => (
						<ArtworkCard
							src={item.src}
							alt={item.alt}
							title={item.title}
							variant={item.variant}
							purchaseUrl={item.purchaseUrl}
						/>
					))
				}
			</div>
		</section>

		<section class="artwork-cta" aria-labelledby="artwork-cta-heading">
			<div class="artwork-cta__divider" aria-hidden="true">
				<img src={contactDividerTop.src} alt="" loading="lazy" decoding="async" />
			</div>
			<div class="artwork-cta__inner">
				<img class="artwork-cta__cat" src={cat.src} alt="" loading="lazy" decoding="async" />
				<h2 id="artwork-cta-heading">Want to know more about my art?</h2>
				<div class="artwork-cta__methods">
					<div class="artwork-cta__method">
						<p>Send me an email at</p>
						<a class="artwork-cta__chip" href="mailto:whiteyedcat@gmail.com" aria-label="Email whiteyedcat">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<path d="M3.8 5.5h16.4c.7 0 1.3.6 1.3 1.3v10.4c0 .7-.6 1.3-1.3 1.3H3.8c-.7 0-1.3-.6-1.3-1.3V6.8c0-.7.6-1.3 1.3-1.3Zm.9 2.2 7.3 5.1 7.3-5.1H4.7Zm14.8 8.6V9.7l-7.1 4.9a.8.8 0 0 1-.9 0L4.5 9.7v6.6h15Z"></path>
							</svg>
							<span>whiteyedcat@gmail</span>
						</a>
					</div>
					<div class="artwork-cta__method">
						<p>Or DM me on</p>
						<a class="artwork-cta__chip" href="https://www.instagram.com/whiteyedcat/" aria-label="DM whiteyedcat on Instagram">
							<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
								<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
								<circle cx="12" cy="12" r="3.25"></circle>
								<circle cx="16.25" cy="7.75" r="0.8"></circle>
							</svg>
							<span>@whiteyedcat</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<SiteFooter />
	</main>
</Layout>

<script>
	const layoutArtworkMasonry = () => {
		document.querySelectorAll<HTMLElement>('[data-masonry-gallery]').forEach((gallery) => {
			const styles = window.getComputedStyle(gallery);
			const rowHeight = Number.parseFloat(styles.getPropertyValue('grid-auto-rows'));
			const rowGap = Number.parseFloat(styles.getPropertyValue('row-gap'));

			if (!rowHeight) return;

			gallery.querySelectorAll<HTMLElement>('[data-artwork-card]').forEach((card) => {
				card.style.gridRowEnd = '';
				const cardHeight = card.getBoundingClientRect().height;
				const rowSpan = Math.ceil((cardHeight + rowGap) / (rowHeight + rowGap));
				card.style.gridRowEnd = `span ${rowSpan}`;
			});
		});
	};

	let masonryFrame = 0;
	const queueArtworkMasonry = () => {
		window.cancelAnimationFrame(masonryFrame);
		masonryFrame = window.requestAnimationFrame(layoutArtworkMasonry);
	};

	window.addEventListener('load', queueArtworkMasonry);
	window.addEventListener('resize', queueArtworkMasonry);
	document.fonts?.ready.then(queueArtworkMasonry);
	queueArtworkMasonry();
</script>

<style>
	:root {
		--art-bg: #f9f5f2;
		--art-surface: #ffffff;
		--art-text: #121212;
		--art-inverse: #f2eee6;
		--art-footer: #0b0b0b;
		--art-tag: #f6c813;
		--art-shell: min(1180px, calc(100vw - 2rem));
		--site-footer-bg: var(--art-footer);
		--site-footer-text: var(--art-inverse);
		--site-footer-shell: var(--art-shell);
		--site-footer-focus: var(--art-inverse);
	}

	.artwork-page {
		min-height: 100vh;
		background: var(--art-surface);
		color: var(--art-text);
		overflow: clip;
	}

	.artwork-header {
		background: var(--art-surface);
		padding: clamp(2rem, 5vw, 3.1rem) 1rem 1.45rem;
	}

	.artist-lockup {
		width: min(48rem, 100%);
		margin: 0 auto;
		display: grid;
		grid-template-columns: clamp(6.4rem, 16vw, 12rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.2rem, 3vw, 2rem);
	}

	.artist-lockup > img {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
	}

	.artist-lockup__copy {
		min-width: 0;
		display: grid;
		gap: 0.55rem;
	}

	.artist-lockup__topline {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 3vw, 2.2rem);
	}

	.artist-lockup h1,
	.artwork-footer__brand h2 {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-weight: 400;
		line-height: 0.92;
	}

	.artist-lockup h1 {
		font-size: clamp(3.9rem, 8.3vw, 6.25rem);
	}

	.social-links {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1;
	}

	.social-links a {
		display: inline-grid;
		place-items: center;
		width: 1rem;
		height: 1rem;
	}

	.social-links svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.role-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.role-pill {
		min-width: clamp(7rem, 15vw, 10.3rem);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.18rem 1rem 0.24rem;
		border: 2px solid var(--art-text);
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.artist-lockup p {
		margin: 0;
		font-size: clamp(0.95rem, 1.9vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
	}

	.artwork-nav {
		width: var(--art-shell);
		margin: clamp(1.8rem, 4vw, 3.15rem) auto 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: clamp(0.82rem, 1.4vw, 1rem);
		font-weight: 700;
	}

	.artwork-nav a {
		position: relative;
		padding-block: 0.3rem;
		white-space: nowrap;
	}

	.artwork-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 180ms ease;
	}

	.artwork-nav a:hover::after,
	.artwork-nav a:focus-visible::after,
	.artwork-nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.artwork-gallery {
		width: var(--art-shell);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.7rem) 0 clamp(4.5rem, 8vw, 6rem);
		background: var(--art-surface);
		box-shadow: 0 0 0 100vmax var(--art-surface);
		clip-path: inset(0 -100vmax);
	}

	.gallery-heading {
		text-align: center;
		margin-bottom: clamp(1.2rem, 3vw, 1.75rem);
	}

	.gallery-heading h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
	}

	.gallery-heading p {
		margin: 0.35rem 0 0;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.28rem;
		font-size: clamp(0.9rem, 1.8vw, 1.5rem);
		font-weight: 500;
		line-height: 1.35;
	}

	.inline-buy {
		display: inline-flex;
		vertical-align: middle;
	}

	.gallery-columns {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: 0.5rem;
		gap: clamp(1rem, 2vw, 1.55rem);
		align-items: start;
	}

	.buy-button {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 1.45rem;
		padding: 0.18rem 0.48rem;
		border: 0;
		border-radius: 999px;
		background: var(--art-footer);
		color: #ffffff;
		font-size: 0.63rem;
		font-weight: 700;
		line-height: 1;
		cursor: not-allowed;
		opacity: 1;
	}

	.buy-button svg {
		width: 0.88rem;
		height: 0.88rem;
		fill: var(--art-tag);
		flex: 0 0 auto;
	}

	.artwork-cta {
		position: relative;
		background: var(--art-surface);
		padding-bottom: clamp(8rem, 14vw, 12rem);
	}

	.artwork-cta__divider {
		width: min(2000px, 100%);
		margin: clamp(1rem, 2vw, 1.6rem) auto clamp(2.2rem, 5vw, 4.6rem);
		pointer-events: none;
	}

	.artwork-cta__divider img {
		width: 100%;
		height: auto;
		display: block;
	}

	.artwork-cta__inner {
		width: var(--art-shell);
		margin: 0 auto;
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.artwork-cta__cat {
		width: clamp(8rem, 17vw, 13.7rem);
		aspect-ratio: 1;
		object-fit: contain;
		margin-bottom: clamp(0.8rem, 2vw, 1.35rem);
	}

	.artwork-cta h2 {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(2.1rem, 4vw, 3rem);
		line-height: 1.05;
	}

	.artwork-cta__methods {
		display: grid;
		gap: 0.72rem;
		margin-top: clamp(1rem, 2vw, 1.45rem);
		font-size: clamp(0.95rem, 1.55vw, 1.5rem);
		font-weight: 500;
	}

	.artwork-cta__method {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}

	.artwork-cta__method p {
		min-width: 11.75rem;
		margin: 0;
		text-align: right;
		line-height: 1.25;
	}

	.artwork-cta__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.48rem;
		min-height: 2rem;
		padding: 0.2rem 0.66rem;
		border: 1.5px solid var(--art-text);
		border-radius: 0.45rem;
		background: var(--art-surface);
		color: var(--art-text);
		line-height: 1;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	.artwork-cta__chip:hover,
	.artwork-cta__chip:focus-visible {
		background: var(--art-text);
		color: var(--art-inverse);
		transform: translateY(-1px);
	}

	.artwork-cta__chip svg {
		width: 1.45rem;
		height: 1.45rem;
		flex: 0 0 auto;
	}

	.artwork-cta__method:first-child .artwork-cta__chip svg {
		fill: currentColor;
	}

	.artwork-cta__chip rect,
	.artwork-cta__chip circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.artwork-footer {
		position: relative;
		background: var(--art-footer);
		color: var(--art-inverse);
	}

	.artwork-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		height: clamp(4.5rem, 12vw, 7.5rem);
		background: transparent;
		overflow: hidden;
		pointer-events: none;
	}

	.artwork-footer__wave svg {
		position: absolute;
		inset: auto -1px -1px;
		width: calc(100% + 2px);
		height: 100%;
		display: block;
	}

	.artwork-footer__wave g {
		will-change: transform;
	}

	.artwork-footer__wave path {
		fill: var(--art-footer);
	}

	.artwork-footer__inner {
		width: var(--art-shell);
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.artwork-footer__brand img {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.artwork-footer__brand h2 {
		font-size: clamp(4rem, 8vw, 7.25rem);
	}

	.footer-socials,
	.credit {
		margin: 0;
	}

	.footer-socials {
		margin-top: 1.1rem;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
	}

	.credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.artwork-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.artwork-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.artwork-nav a:focus-visible,
	.social-links a:focus-visible,
	.artwork-cta__chip:focus-visible,
	.artwork-footer a:focus-visible {
		outline: 2px solid var(--art-text);
		outline-offset: 0.28rem;
	}

	.artwork-footer a:focus-visible {
		outline-color: var(--art-inverse);
	}

	@media (max-width: 920px) {
		.artwork-nav {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.85rem 1.4rem;
		}

		.gallery-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.artwork-cta__divider {
			margin-top: clamp(1.4rem, 5vw, 2.4rem);
		}

		.artwork-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.artwork-footer__links {
			max-width: 30rem;
		}
	}

	@media (max-width: 640px) {
		:root {
			--art-shell: min(100vw - 1.25rem, 34rem);
		}

		.artwork-header {
			padding-top: 1.4rem;
		}

		.artist-lockup {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.artist-lockup > img {
			width: 7.5rem;
		}

		.artist-lockup__topline {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.6rem 1rem;
		}

		.role-pills {
			justify-content: center;
		}

		.gallery-columns {
			gap: 0.85rem;
		}

		.artwork-cta {
			padding-bottom: 7rem;
		}

		.artwork-cta__divider {
			width: 145%;
			margin-left: -22.5%;
			margin-bottom: 2rem;
		}

		.artwork-cta__cat {
			width: clamp(7.25rem, 42vw, 10rem);
		}

		.artwork-cta__method {
			display: grid;
			justify-items: center;
			gap: 0.45rem;
		}

		.artwork-cta__method p {
			min-width: 0;
			text-align: center;
		}

		.artwork-cta__chip {
			min-height: 2.45rem;
		}

		.artwork-footer__brand,
		.artwork-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.artwork-footer__brand img {
			margin-inline: auto;
		}

		.artwork-footer__links {
			justify-self: center;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.artwork-cta__chip {
			transition: none;
		}
	}
</style>
