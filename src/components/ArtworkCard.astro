---
interface Props {
	src: { src: string } | string;
	alt: string;
	title: string;
	variant: 'portrait' | 'square';
	purchaseUrl?: string | null;
	class?: string;
}

const {
	src,
	alt,
	title,
	variant,
	purchaseUrl = null,
	class: className = '',
} = Astro.props;

const imageSrc = typeof src === 'string' ? src : src.src;
const cardClass = [
	'artwork-card',
	`artwork-card--${variant}`,
	purchaseUrl ? 'artwork-card--has-buy' : '',
	className,
].filter(Boolean).join(' ');
---

<article class={cardClass} data-artwork-card tabindex="0" aria-pressed="false" aria-label={`Show title for ${title}`}>
	<div class="artwork-card__inner">
		<div class="artwork-card__face artwork-card__front">
			<img src={imageSrc} alt={alt} loading="lazy" decoding="async" />
		</div>
		<div class="artwork-card__face artwork-card__back">
			<p>{title}</p>
		</div>
	</div>
	{
		purchaseUrl && (
			<a class="artwork-card__buy" href={purchaseUrl} target="_blank" rel="noopener noreferrer" aria-label={`Buy ${title}`}>
				<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
					<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V5.5a2.7 2.7 0 0 1 2.7-2.7H12c.5 0 1 .2 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8ZM7.2 8.7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path>
				</svg>
				<span>buy me</span>
			</a>
		)
	}
</article>

<script>
	const getArtworkCard = (target: EventTarget | null) => {
		if (!(target instanceof Element)) return null;
		return target.closest<HTMLElement>('[data-artwork-card]');
	};

	const toggleArtworkCard = (card: HTMLElement) => {
		const isFlipped = card.classList.toggle('is-flipped');
		card.classList.toggle('is-hover-suppressed', !isFlipped);
		card.setAttribute('aria-pressed', String(isFlipped));
	};

	document.addEventListener('pointerleave', (event) => {
		const card = getArtworkCard(event.target);
		if (!card) return;

		card.classList.remove('is-hover-suppressed');
	}, true);

	document.addEventListener('click', (event) => {
		const card = getArtworkCard(event.target);
		if (!card) return;
		if (event.target instanceof Element && event.target.closest('a')) return;

		toggleArtworkCard(card);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Enter' && event.key !== ' ') return;

		const card = getArtworkCard(event.target);
		if (!card) return;

		event.preventDefault();
		toggleArtworkCard(card);
	});
</script>

<style>
	.artwork-card {
		--artwork-card-radius: 0.45rem;
		--artwork-card-bg: #0b0b0b;
		--artwork-card-shadow: none;
		--artwork-card-title-bg: rgb(0 0 0 / 0.86);
		--artwork-card-title-color: #f2eee6;
		--artwork-card-tag: #f6c813;
		position: relative;
		border-radius: var(--artwork-card-radius);
		background: var(--artwork-card-bg);
		box-shadow: var(--artwork-card-shadow);
		cursor: pointer;
		outline: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
	}

	.artwork-card--portrait {
		aspect-ratio: 720 / 900;
	}

	.artwork-card--square {
		aspect-ratio: 1;
	}

	.artwork-card__inner,
	.artwork-card__face {
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.artwork-card__inner {
		overflow: hidden;
	}

	.artwork-card__face {
		overflow: hidden;
	}

	.artwork-card__front {
		background: var(--artwork-card-bg);
	}

	.artwork-card__front img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.artwork-card__back {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: clamp(1rem, 4vw, 2rem);
		background: transparent;
		color: var(--artwork-card-title-color);
		text-align: center;
		pointer-events: none;
		z-index: 2;
	}

	.artwork-card__back::before {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 62%;
		background: linear-gradient(
			to top,
			var(--artwork-card-title-bg) 0%,
			rgb(0 0 0 / 0.64) 34%,
			rgb(0 0 0 / 0) 100%
		);
		opacity: 0;
		transition: opacity 260ms ease;
		z-index: 0;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back,
	.artwork-card.is-flipped .artwork-card__back {
		opacity: 1;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back::before,
	.artwork-card.is-flipped .artwork-card__back::before {
		opacity: 1;
	}

	.artwork-card__back p {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(1.25rem, 5vw, 2.35rem);
		line-height: 0.98;
		opacity: 0;
		position: relative;
		transform: translateY(1.15rem);
		transition:
			opacity 220ms ease,
			transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
		z-index: 1;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back p,
	.artwork-card.is-flipped .artwork-card__back p {
		opacity: 1;
		transform: translateY(0);
	}

	.artwork-card__buy {
		position: absolute;
		right: 0.45rem;
		top: 0.45rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.36rem;
		min-height: 2.05rem;
		padding: 0.26rem 0.62rem 0.26rem 0.42rem;
		border-radius: 999px;
		background: #0b0b0b;
		color: #ffffff;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1;
	}

	.artwork-card__buy svg {
		width: 1.55rem;
		height: 1.55rem;
		fill: var(--artwork-card-tag);
		flex: 0 0 auto;
	}

	.artwork-card:focus-visible {
		outline: 3px solid var(--artwork-card-tag);
		outline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.artwork-card__inner {
			transition: none;
		}

		.artwork-card__back::before,
		.artwork-card__back p {
			transition: none;
		}

		.artwork-card__back p {
			transform: none;
		}
	}
</style>
