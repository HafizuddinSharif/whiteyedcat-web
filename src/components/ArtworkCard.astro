---
interface Props {
	src: { src: string } | string;
	alt: string;
	title: string;
	variant: 'portrait' | 'square' | 'landscape';
	purchaseUrl?: string | null;
	class?: string;
}

const {
	src,
	alt,
	title,
	variant,
	purchaseUrl = null,
	class: className = '',
} = Astro.props;

const imageSrc = typeof src === 'string' ? src : src.src;
const cardClass = [
	'artwork-card',
	`artwork-card--${variant}`,
	purchaseUrl ? 'artwork-card--has-buy' : '',
	className,
].filter(Boolean).join(' ');
---

<article class={cardClass} data-artwork-card tabindex="0" aria-label={`View ${title} fullscreen`}>
	<div class="artwork-card__inner">
		<div class="artwork-card__face artwork-card__front">
			<img src={imageSrc} alt={alt} loading="lazy" decoding="async" />
		</div>
		<div class="artwork-card__face artwork-card__back">
			<p>{title}</p>
		</div>
	</div>
	<button class="artwork-card__enlarge" type="button" data-artwork-open aria-label={`View ${title} fullscreen`}>
		<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
			<path d="M8.7 4.8H5.9c-.6 0-1.1.5-1.1 1.1v2.8H3V5.9C3 4.3 4.3 3 5.9 3h2.8v1.8Zm6.6 0V3h2.8C19.7 3 21 4.3 21 5.9v2.8h-1.8V5.9c0-.6-.5-1.1-1.1-1.1h-2.8ZM4.8 15.3v2.8c0 .6.5 1.1 1.1 1.1h2.8V21H5.9A2.9 2.9 0 0 1 3 18.1v-2.8h1.8Zm14.4 0H21v2.8a2.9 2.9 0 0 1-2.9 2.9h-2.8v-1.8h2.8c.6 0 1.1-.5 1.1-1.1v-2.8Z"></path>
		</svg>
	</button>
	{
		purchaseUrl && (
			<a class="artwork-card__buy" href={purchaseUrl} target="_blank" rel="noopener noreferrer" aria-label={`Buy ${title}`}>
				<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
					<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 2.8 12V5.5a2.7 2.7 0 0 1 2.7-2.7H12c.5 0 1 .2 1.4.6l7.2 7.2a2 2 0 0 1 0 2.8ZM7.2 8.7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path>
				</svg>
				<span>buy me</span>
			</a>
		)
	}
	<dialog class="artwork-card__viewer" data-artwork-viewer aria-label={`${title} fullscreen view`}>
		<button class="artwork-card__viewer-close" type="button" data-artwork-close aria-label="Close fullscreen artwork">
			<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
				<path d="m6.4 5.1 5.6 5.6 5.6-5.6 1.3 1.3-5.6 5.6 5.6 5.6-1.3 1.3-5.6-5.6-5.6 5.6-1.3-1.3 5.6-5.6-5.6-5.6 1.3-1.3Z"></path>
			</svg>
		</button>
		<figure class="artwork-card__viewer-figure">
			<img src={imageSrc} alt={alt} decoding="async" data-artwork-viewer-img />
			<figcaption>{title}</figcaption>
		</figure>
	</dialog>
</article>

<script>
	const getArtworkCard = (target: EventTarget | null) => {
		if (!(target instanceof Element)) return null;
		return target.closest<HTMLElement>('[data-artwork-card]');
	};

	const setArtworkViewerMotion = (viewer: HTMLDialogElement, sourceRect: DOMRect) => {
		const viewerImage = viewer.querySelector<HTMLImageElement>('[data-artwork-viewer-img]');
		if (!viewerImage) return;

		const targetRect = viewerImage.getBoundingClientRect();
		const sourceCenterX = sourceRect.left + sourceRect.width / 2;
		const sourceCenterY = sourceRect.top + sourceRect.height / 2;
		const targetCenterX = targetRect.left + targetRect.width / 2;
		const targetCenterY = targetRect.top + targetRect.height / 2;
		const sourceScale = targetRect.width > 0 ? sourceRect.width / targetRect.width : 1;

		viewer.style.setProperty('--artwork-motion-x', `${sourceCenterX - targetCenterX}px`);
		viewer.style.setProperty('--artwork-motion-y', `${sourceCenterY - targetCenterY}px`);
		viewer.style.setProperty('--artwork-motion-scale', `${sourceScale}`);
	};

	const waitForArtworkViewerImage = async (viewer: HTMLDialogElement) => {
		const viewerImage = viewer.querySelector<HTMLImageElement>('[data-artwork-viewer-img]');
		if (!viewerImage || (viewerImage.complete && viewerImage.naturalWidth > 0)) return;

		try {
			await viewerImage.decode();
		} catch {
			// Continue with the browser's current layout if decoding is interrupted.
		}
	};

	const updateArtworkViewerScrollLock = () => {
		document.documentElement.classList.toggle('has-artwork-viewer', Boolean(document.querySelector('[data-artwork-viewer][open]')));
	};

	const openArtworkViewer = async (card: HTMLElement) => {
		const viewer = card.querySelector<HTMLDialogElement>('[data-artwork-viewer]');
		const cardImage = card.querySelector<HTMLImageElement>('.artwork-card__front img');
		if (!viewer) return;

		const sourceRect = (cardImage ?? card).getBoundingClientRect();
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		viewer.classList.remove('is-opening', 'is-closing');

		if (typeof viewer.showModal === 'function') {
			viewer.showModal();
		} else {
			viewer.setAttribute('open', '');
		}

		document.documentElement.classList.add('has-artwork-viewer');

		if (prefersReducedMotion) return;

		viewer.classList.add('is-preparing');
		await waitForArtworkViewerImage(viewer);
		if (!viewer.open || viewer.classList.contains('is-closing')) return;

		window.requestAnimationFrame(() => {
			setArtworkViewerMotion(viewer, sourceRect);
			viewer.classList.remove('is-preparing');
			viewer.classList.add('is-opening');

			window.setTimeout(() => {
				viewer.classList.remove('is-opening');
			}, 430);
		});
	};

	const closeArtworkViewer = (viewer: HTMLDialogElement) => {
		if (!viewer.open || viewer.classList.contains('is-closing')) return;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (prefersReducedMotion) {
			viewer.close();
			updateArtworkViewerScrollLock();
			return;
		}

		const card = viewer.closest<HTMLElement>('[data-artwork-card]');
		const cardImage = card?.querySelector<HTMLImageElement>('.artwork-card__front img');
		if (cardImage) {
			setArtworkViewerMotion(viewer, cardImage.getBoundingClientRect());
		}

		viewer.classList.remove('is-opening', 'is-preparing');
		viewer.classList.add('is-closing');
		window.setTimeout(() => {
			viewer.classList.remove('is-closing');
			viewer.close();
			updateArtworkViewerScrollLock();
		}, 360);
	};

	document.addEventListener('click', (event) => {
		const card = getArtworkCard(event.target);
		if (!card) return;
		if (!(event.target instanceof Element)) return;

		const viewer = event.target.closest<HTMLDialogElement>('[data-artwork-viewer]');
		if (viewer) {
			if (
				event.target.closest('[data-artwork-close]') ||
				event.target === viewer ||
				event.target.classList.contains('artwork-card__viewer-figure')
			) {
				closeArtworkViewer(viewer);
			}

			return;
		}

		if (event.target.closest('a')) return;

		openArtworkViewer(card);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Enter' && event.key !== ' ') return;
		if (event.target instanceof Element && event.target.closest('a, button, [data-artwork-viewer]')) return;

		const card = getArtworkCard(event.target);
		if (!card) return;

		event.preventDefault();
		openArtworkViewer(card);
	});

	document.addEventListener('cancel', (event) => {
		if (!(event.target instanceof HTMLDialogElement)) return;
		if (!event.target.matches('[data-artwork-viewer]')) return;

		event.preventDefault();
		closeArtworkViewer(event.target);
	});

	document.addEventListener('close', (event) => {
		if (!(event.target instanceof HTMLDialogElement)) return;
		if (!event.target.matches('[data-artwork-viewer]')) return;

		updateArtworkViewerScrollLock();
	}, true);
</script>

<style>
	.artwork-card {
		--artwork-card-radius: 0.45rem;
		--artwork-card-bg: #0b0b0b;
		--artwork-card-shadow: none;
		--artwork-card-title-bg: rgb(0 0 0 / 0.86);
		--artwork-card-title-color: #f2eee6;
		--artwork-card-tag: #f6c813;
		position: relative;
		border-radius: var(--artwork-card-radius);
		background: var(--artwork-card-bg);
		box-shadow: var(--artwork-card-shadow);
		cursor: pointer;
		outline: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
	}

	:global(html.has-artwork-viewer) {
		overflow: hidden;
	}

	.artwork-card--portrait {
		aspect-ratio: 720 / 900;
	}

	.artwork-card--square {
		aspect-ratio: 1;
	}

	.artwork-card--landscape {
		aspect-ratio: 600 / 412;
	}

	.artwork-card__inner,
	.artwork-card__face {
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.artwork-card__inner {
		overflow: hidden;
	}

	.artwork-card__face {
		overflow: hidden;
	}

	.artwork-card__front {
		background: var(--artwork-card-bg);
	}

	.artwork-card__front img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.artwork-card__back {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: clamp(1rem, 4vw, 2rem);
		background: transparent;
		color: var(--artwork-card-title-color);
		text-align: center;
		pointer-events: none;
		z-index: 2;
	}

	.artwork-card__back::before {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 62%;
		background: linear-gradient(
			to top,
			var(--artwork-card-title-bg) 0%,
			rgb(0 0 0 / 0.64) 34%,
			rgb(0 0 0 / 0) 100%
		);
		opacity: 0;
		transition: opacity 260ms ease;
		z-index: 0;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back,
	.artwork-card.is-flipped .artwork-card__back {
		opacity: 1;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back::before,
	.artwork-card.is-flipped .artwork-card__back::before {
		opacity: 1;
	}

	.artwork-card__back p {
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(1.25rem, 5vw, 2.35rem);
		line-height: 0.98;
		opacity: 0;
		position: relative;
		transform: translateY(1.15rem);
		transition:
			opacity 220ms ease,
			transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
		z-index: 1;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__back p,
	.artwork-card.is-flipped .artwork-card__back p {
		opacity: 1;
		transform: translateY(0);
	}

	.artwork-card__enlarge,
	.artwork-card__viewer-close {
		border: 0;
		color: #ffffff;
		cursor: pointer;
		line-height: 0;
	}

	.artwork-card__enlarge {
		position: absolute;
		left: 0.45rem;
		top: 0.45rem;
		z-index: 3;
		display: inline-grid;
		place-items: center;
		width: 2.05rem;
		height: 2.05rem;
		padding: 0;
		border-radius: 999px;
		background: rgb(11 11 11 / 0.86);
		opacity: 0;
		transform: translateY(-0.35rem) scale(0.94);
		transition:
			opacity 180ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 180ms ease;
	}

	.artwork-card__enlarge svg,
	.artwork-card__viewer-close svg {
		width: 1.18rem;
		height: 1.18rem;
		fill: currentColor;
	}

	.artwork-card:not(.is-hover-suppressed):hover .artwork-card__enlarge,
	.artwork-card:focus-visible .artwork-card__enlarge,
	.artwork-card:focus-within .artwork-card__enlarge {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.artwork-card__enlarge:hover,
	.artwork-card__viewer-close:hover {
		background: #000000;
	}

	.artwork-card__enlarge:focus-visible,
	.artwork-card__viewer-close:focus-visible {
		outline: 3px solid var(--artwork-card-tag);
		outline-offset: 3px;
	}

	.artwork-card__buy {
		position: absolute;
		right: 0.45rem;
		top: 0.45rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.36rem;
		min-height: 2.05rem;
		padding: 0.26rem 0.62rem 0.26rem 0.42rem;
		border-radius: 999px;
		background: #0b0b0b;
		color: #ffffff;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1;
	}

	.artwork-card__buy svg {
		width: 1.55rem;
		height: 1.55rem;
		fill: var(--artwork-card-tag);
		flex: 0 0 auto;
	}

	@keyframes artworkViewerDimIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@keyframes artworkViewerDimOut {
		from {
			opacity: 1;
		}

		to {
			opacity: 0;
		}
	}

	@keyframes artworkViewerImageIn {
		from {
			opacity: 1;
			transform: translate(var(--artwork-motion-x), var(--artwork-motion-y)) scale(var(--artwork-motion-scale));
		}

		to {
			opacity: 1;
			transform: translate(0, 0) scale(1);
		}
	}

	@keyframes artworkViewerImageOut {
		from {
			opacity: 1;
			transform: translate(0, 0) scale(1);
		}

		to {
			opacity: 1;
			transform: translate(var(--artwork-motion-x), var(--artwork-motion-y)) scale(var(--artwork-motion-scale));
		}
	}

	@keyframes artworkViewerChromeIn {
		from {
			opacity: 0;
			transform: translateY(0.3rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes artworkViewerChromeOut {
		from {
			opacity: 1;
			transform: translateY(0);
		}

		to {
			opacity: 0;
			transform: translateY(0.3rem);
		}
	}

	.artwork-card__viewer {
		--artwork-motion-x: 0px;
		--artwork-motion-y: 0px;
		--artwork-motion-scale: 1;
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(1rem, 3vw, 2rem);
		border: 0;
		background: transparent;
		color: #f2eee6;
		cursor: zoom-out;
	}

	.artwork-card__viewer::backdrop {
		background: rgb(0 0 0 / 0.74);
	}

	.artwork-card__viewer[open].is-preparing::backdrop {
		opacity: 0;
	}

	.artwork-card__viewer[open].is-opening::backdrop {
		animation: artworkViewerDimIn 360ms ease both;
	}

	.artwork-card__viewer[open].is-closing::backdrop {
		animation: artworkViewerDimOut 320ms ease both;
	}

	.artwork-card__viewer-figure {
		width: 100%;
		height: 100%;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.8rem;
	}

	.artwork-card__viewer[open].is-preparing .artwork-card__viewer-figure img,
	.artwork-card__viewer[open].is-preparing .artwork-card__viewer-figure figcaption,
	.artwork-card__viewer[open].is-preparing .artwork-card__viewer-close {
		opacity: 0;
	}

	.artwork-card__viewer[open].is-opening .artwork-card__viewer-figure img {
		animation: artworkViewerImageIn 420ms cubic-bezier(0.2, 0.9, 0.22, 1) both;
	}

	.artwork-card__viewer[open].is-closing .artwork-card__viewer-figure img {
		animation: artworkViewerImageOut 340ms cubic-bezier(0.58, 0, 0.4, 1) both;
	}

	.artwork-card__viewer-figure img {
		width: auto;
		height: auto;
		max-width: min(100%, 1200px);
		max-height: calc(100dvh - 7rem);
		object-fit: contain;
		box-shadow: 0 1.4rem 4rem rgb(0 0 0 / 0.38);
		transform-origin: center;
		will-change: transform;
	}

	.artwork-card__viewer-figure figcaption {
		max-width: min(100%, 54rem);
		margin: 0;
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(1.15rem, 2.2vw, 2rem);
		line-height: 1.05;
		text-align: center;
	}

	@media (max-width: 640px) {
		.artwork-card__viewer {
			padding: 1rem;
		}

		.artwork-card__viewer-figure {
			gap: 0.55rem;
		}

		.artwork-card__viewer-figure img {
			max-height: calc(100dvh - 5.4rem);
		}
	}

	.artwork-card__viewer[open].is-opening .artwork-card__viewer-figure figcaption,
	.artwork-card__viewer[open].is-opening .artwork-card__viewer-close {
		animation: artworkViewerChromeIn 240ms ease 180ms both;
	}

	.artwork-card__viewer[open].is-closing .artwork-card__viewer-figure figcaption,
	.artwork-card__viewer[open].is-closing .artwork-card__viewer-close {
		animation: artworkViewerChromeOut 140ms ease both;
	}

	.artwork-card__viewer-close {
		position: fixed;
		right: clamp(0.75rem, 2vw, 1.4rem);
		top: clamp(0.75rem, 2vw, 1.4rem);
		z-index: 2;
		display: inline-grid;
		place-items: center;
		width: 2.7rem;
		height: 2.7rem;
		padding: 0;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.74);
	}

	.artwork-card:focus-visible {
		outline: 3px solid var(--artwork-card-tag);
		outline-offset: 4px;
	}

	@media (hover: none) {
		.artwork-card__enlarge {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.artwork-card__inner {
			transition: none;
		}

		.artwork-card__back::before,
		.artwork-card__back p,
		.artwork-card__enlarge {
			transition: none;
		}

		.artwork-card__back p {
			transform: none;
		}

		.artwork-card__viewer[open]::backdrop,
		.artwork-card__viewer[open].is-opening::backdrop,
		.artwork-card__viewer[open].is-closing::backdrop,
		.artwork-card__viewer[open].is-opening .artwork-card__viewer-figure img,
		.artwork-card__viewer[open].is-closing .artwork-card__viewer-figure img,
		.artwork-card__viewer[open].is-opening .artwork-card__viewer-figure figcaption,
		.artwork-card__viewer[open].is-opening .artwork-card__viewer-close,
		.artwork-card__viewer[open].is-closing .artwork-card__viewer-figure figcaption,
		.artwork-card__viewer[open].is-closing .artwork-card__viewer-close {
			animation: none;
		}
	}
</style>
