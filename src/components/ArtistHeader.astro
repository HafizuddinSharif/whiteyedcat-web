---
import avatar from '../assets/whiteyedcat/avatar.png';

interface Props {
	currentHref: string;
}

const { currentHref } = Astro.props;

const tagline = 'I live for rock garage survival...and cats';

const navigation = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/#about' },
	{ label: 'Artwork', href: '/artworks' },
	{ label: 'Collaboration', href: '/collabs' },
	{ label: 'Commission', href: '/commissions' },
	{ label: 'Exhibition', href: '/exhibitions' },
	{ label: 'Contacts', href: '/contact' },
];
---

<header class="artist-header">
	<div class="artist-header__lockup">
		<img src={avatar.src} alt="whiteyedcat illustrated profile avatar." loading="eager" decoding="async" />
		<div class="artist-header__copy">
			<div class="artist-header__topline">
				<h1>whiteyedcat</h1>
				<div class="artist-header__social-links" aria-label="Social links">
					<a href="https://x.com/whiteyedcat" aria-label="X">X</a>
					<a href="https://www.instagram.com/whiteyedcat/" aria-label="Instagram">
						<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
							<rect x="5" y="5" width="14" height="14" rx="4"></rect>
							<circle cx="12" cy="12" r="3.2"></circle>
							<circle cx="16.3" cy="7.7" r="0.8"></circle>
						</svg>
					</a>
					<a href="https://www.threads.net/@whiteyedcat" aria-label="Threads">@</a>
				</div>
			</div>
			<div class="artist-header__roles" aria-label="Creative roles">
				<span class="artist-header__role">
					<span aria-hidden="true">✦</span>
					painter
				</span>
				<span class="artist-header__role">
					<span aria-hidden="true">✦</span>
					illustrator
				</span>
			</div>
			<p>{tagline}</p>
		</div>
	</div>

	<nav class="artist-header__nav" aria-label="Primary">
		{
			navigation.map((item) => (
				<a href={item.href} aria-current={item.href === currentHref ? 'page' : undefined}>{item.label}</a>
			))
		}
	</nav>
</header>

<style>
	.artist-header {
		background: var(--artist-header-bg, #ffffff);
		padding: clamp(2rem, 5vw, 3.1rem) 1rem 1.45rem;
	}

	.artist-header__lockup {
		width: min(48rem, 100%);
		margin: 0 auto;
		display: grid;
		grid-template-columns: clamp(6.4rem, 16vw, 12rem) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.2rem, 3vw, 2rem);
	}

	.artist-header__lockup > img {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
	}

	.artist-header__copy {
		min-width: 0;
		display: grid;
		gap: 0.55rem;
	}

	.artist-header__topline {
		display: flex;
		align-items: center;
		gap: clamp(0.8rem, 3vw, 2.2rem);
	}

	.artist-header h1 {
		margin: 0;
		font-family: 'Birthstone', cursive;
		font-size: clamp(3.9rem, 8.3vw, 6.25rem);
		font-weight: 400;
		line-height: 0.92;
	}

	.artist-header__social-links {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1;
	}

	.artist-header__social-links a {
		display: inline-grid;
		place-items: center;
		width: 1rem;
		height: 1rem;
	}

	.artist-header__social-links svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.artist-header__roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.artist-header__role {
		min-width: clamp(7rem, 15vw, 10.3rem);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.18rem 1rem 0.24rem;
		border: 2px solid currentColor;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.artist-header p {
		margin: 0;
		font-size: clamp(0.95rem, 1.9vw, 1.5rem);
		font-weight: 500;
		line-height: 1.25;
	}

	.artist-header__nav {
		width: min(1180px, calc(100vw - 2rem));
		margin: clamp(1.8rem, 4vw, 3.15rem) auto 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: clamp(0.82rem, 1.4vw, 1rem);
		font-weight: 700;
	}

	.artist-header__nav a {
		position: relative;
		padding-block: 0.3rem;
		white-space: nowrap;
	}

	.artist-header__nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 180ms ease;
	}

	.artist-header__nav a:hover::after,
	.artist-header__nav a:focus-visible::after,
	.artist-header__nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.artist-header__nav a:focus-visible,
	.artist-header__social-links a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.28rem;
	}

	@media (max-width: 920px) {
		.artist-header__nav {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.85rem 1.4rem;
		}
	}

	@media (max-width: 640px) {
		.artist-header {
			padding-top: 1.4rem;
		}

		.artist-header__lockup {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.artist-header__lockup > img {
			width: 7.5rem;
		}

		.artist-header__topline {
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.6rem 1rem;
		}

		.artist-header__roles {
			justify-content: center;
		}

		.artist-header__nav {
			width: min(100vw - 1.25rem, 34rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.artist-header__nav a::after {
			transition: none;
		}
	}
</style>
