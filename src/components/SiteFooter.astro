---
import AnimatedWave from './AnimatedWave.astro';
import avatar from '../assets/whiteyedcat/avatar.png';
import instagramIcon from '../assets/icons/instagram.svg';
import threadsIcon from '../assets/icons/threads.svg';
import tiktokIcon from '../assets/icons/tiktok.svg';

interface FooterLink {
	label: string;
	href: string;
	external?: boolean;
}

interface Props {
	variant?: 'home' | 'standard';
}

const { variant = 'standard' } = Astro.props;

const footerGroups: FooterLink[][] = [
	[
		{ label: 'Home', href: variant === 'home' ? '#top' : '/' },
		{ label: 'Artwork', href: '/artworks' },
		{ label: 'About', href: variant === 'home' ? '#about' : '/#about' },
		{ label: 'Contacts', href: '/contact' },
	],
	[
		{ label: 'Collaboration', href: '/collabs' },
		{ label: 'Commission', href: '/commissions' },
		{ label: 'Exhibition', href: '/exhibitions' },
		{ label: 'Art Shop', href: 'https://whiteyedcat.bigcartel.com', external: true },
	],
];
---

<footer class:list={['site-footer', `site-footer--${variant}`]}>
	<div class="site-footer__wave" aria-hidden="true">
		<AnimatedWave color="var(--site-footer-bg, #0b0b0b)" />
	</div>
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<img class="site-footer__avatar" src={avatar.src} alt="" loading="lazy" decoding="async" />
			<h2>whiteyedcat</h2>
			<div class="site-footer__socials" aria-label="Social links">
				<a href="https://www.instagram.com/whiteyedcat/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<img src={instagramIcon.src} alt="" aria-hidden="true" />
				</a>
				<a href="https://www.threads.net/@whiteyedcat" target="_blank" rel="noopener noreferrer" aria-label="Threads">
					<img src={threadsIcon.src} alt="" aria-hidden="true" />
				</a>
				<a href="https://www.tiktok.com/@whiteyedcat" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
					<img src={tiktokIcon.src} alt="" aria-hidden="true" />
				</a>
			</div>
			<p class="site-footer__credit">Designed and build by <a href="https://snouu.dev">snouu.dev</a></p>
			<div class="site-footer__country-selector">
				<select data-commission-country-select aria-label="Choose commission pricing country">
					<option value="US">United States - USD</option>
					<option value="MY">Malaysia - MYR</option>
				</select>
			</div>
		</div>
		<div class="site-footer__links">
			{
				footerGroups.map((group) => (
					<ul>
						{
							group.map((item) => (
								<li>
									<a
										href={item.href}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noopener noreferrer' : undefined}
									>
										{item.label}
										{
											item.external && (
												<svg class="external-link-icon" width="10" height="10" viewBox="0 0 16 16" focusable="false" aria-hidden="true">
													<path d="M6 3h7v7"></path>
													<path d="M13 3 6 10"></path>
													<path d="M11 8v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h4"></path>
												</svg>
											)
										}
									</a>
								</li>
							))
						}
					</ul>
				))
			}
		</div>
	</div>
</footer>

<script>
	const footerCountrySelector = {
		defaultCountry: 'US',
		storageKey: 'whiteyedcat-commission-country',
		countries: {
			MY: true,
			US: true,
		},
	};

	type FooterCountry = keyof typeof footerCountrySelector.countries;

	const isSupportedFooterCountry = (country: string | null | undefined): country is FooterCountry => {
		return Boolean(country && country in footerCountrySelector.countries);
	};

	const getSavedFooterCountry = () => {
		try {
			return window.localStorage.getItem(footerCountrySelector.storageKey);
		} catch {
			return null;
		}
	};

	const saveFooterCountry = (country: FooterCountry) => {
		try {
			window.localStorage.setItem(footerCountrySelector.storageKey, country);
		} catch {
			return;
		}
	};

	const getFooterCountryFromLocale = (locale: string | undefined) => {
		if (!locale) return null;

		try {
			const region = new Intl.Locale(locale).region;
			return region ? region.toUpperCase() : null;
		} catch {
			const region = locale.split('-')[1];
			return region ? region.toUpperCase() : null;
		}
	};

	const getFooterCountryFromTimezone = () => {
		const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
		const timezoneCountryMap: Record<string, FooterCountry> = {
			'Asia/Kuala_Lumpur': 'MY',
			'America/Adak': 'US',
			'America/Anchorage': 'US',
			'America/Boise': 'US',
			'America/Chicago': 'US',
			'America/Denver': 'US',
			'America/Detroit': 'US',
			'America/Indiana/Indianapolis': 'US',
			'America/Juneau': 'US',
			'America/Kentucky/Louisville': 'US',
			'America/Los_Angeles': 'US',
			'America/New_York': 'US',
			'America/Phoenix': 'US',
			'America/Sitka': 'US',
			'America/Yakutat': 'US',
			'Pacific/Honolulu': 'US',
		};

		return timezoneCountryMap[timezone] ?? null;
	};

	const detectFooterCountry = () => {
		const savedCountry = getSavedFooterCountry();
		if (isSupportedFooterCountry(savedCountry)) return savedCountry;

		const timezoneCountry = getFooterCountryFromTimezone();
		if (timezoneCountry) return timezoneCountry;

		const locales = navigator.languages?.length ? navigator.languages : [navigator.language];
		for (const locale of locales) {
			const country = getFooterCountryFromLocale(locale);
			if (isSupportedFooterCountry(country)) return country;
		}

		return footerCountrySelector.defaultCountry;
	};

	const setFooterCountry = (country: string) => {
		const activeCountry = isSupportedFooterCountry(country) ? country : footerCountrySelector.defaultCountry;

		document.querySelectorAll<HTMLSelectElement>('[data-commission-country-select]').forEach((select) => {
			select.value = activeCountry;
		});

		saveFooterCountry(activeCountry);
		window.dispatchEvent(new CustomEvent('commission-country-change', { detail: { country: activeCountry } }));
	};

	const setupFooterCountrySelectors = () => {
		document.querySelectorAll<HTMLSelectElement>('[data-commission-country-select]').forEach((select) => {
			if (select.dataset.footerCountryReady === 'true') return;

			select.dataset.footerCountryReady = 'true';
			select.addEventListener('change', () => {
				setFooterCountry(select.value);
			});
		});

		setFooterCountry(detectFooterCountry());
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupFooterCountrySelectors, { once: true });
	} else {
		setupFooterCountrySelectors();
	}

	document.addEventListener('astro:page-load', setupFooterCountrySelectors);
</script>

<style>
	.site-footer {
		position: relative;
		background: var(--site-footer-bg, #0b0b0b);
		color: var(--site-footer-text, #f2eee6);
	}

	.site-footer--home {
		margin-top: 2rem;
	}

	.site-footer__wave {
		height: clamp(4.5rem, 12vw, 7.5rem);
		overflow: hidden;
		color: var(--site-footer-bg, #0b0b0b);
	}

	.site-footer--home .site-footer__wave {
		position: relative;
		background: var(--site-footer-wave-bg, #f9f5f2);
	}

	.site-footer--standard .site-footer__wave {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 100%;
		background: transparent;
		pointer-events: none;
	}

	.site-footer__inner {
		width: var(--site-footer-shell, min(1180px, calc(100vw - 2rem)));
		margin: 0 auto;
		padding: clamp(2.1rem, 4vw, 3rem) 0 3.7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
		gap: clamp(2rem, 7vw, 6rem);
		align-items: end;
	}

	.site-footer--home .site-footer__inner {
		padding: 2.5rem 0 3.5rem;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
	}

	.site-footer__avatar {
		width: clamp(5rem, 11vw, 7.6rem);
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.35rem;
	}

	.site-footer--home .site-footer__avatar {
		width: 4.5rem;
		height: 4.5rem;
		margin-bottom: 1rem;
	}

	.site-footer__brand h2 {
		margin: 0;
		color: var(--site-footer-text, #f2eee6);
		font-family: 'Birthstone', cursive;
		font-size: clamp(4rem, 8vw, 7.25rem);
		line-height: 0.9;
		font-weight: 400;
	}

	.site-footer--home .site-footer__brand h2 {
		font-size: clamp(3rem, 7vw, 5rem);
	}

	.site-footer__socials,
	.site-footer__credit {
		margin: 0;
	}

	.site-footer__socials {
		margin-top: 1.1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
	}

	.site-footer--home .site-footer__socials {
		margin-top: 0.4rem;
	}

	.site-footer__socials a {
		display: inline-grid;
		place-items: center;
		width: 1.1rem;
		height: 1.1rem;
	}

	.site-footer__socials img {
		width: 100%;
		height: 100%;
		filter: invert(1);
	}

	.site-footer__credit {
		margin-top: 2.8rem;
		color: rgba(242, 238, 230, 0.78);
		font-size: 0.93rem;
		font-weight: 300;
	}

	.site-footer__credit a:hover {
		text-decoration: underline;
	}

	.site-footer__country-selector {
		margin-top: 1.8rem;
		width: min(100%, 15.75rem);
	}

	.site-footer__country-selector select {
		width: 100%;
		min-height: 2.85rem;
		padding: 0.35rem 2.3rem 0.35rem 0.8rem;
		border: 1.5px solid var(--site-footer-text, #f2eee6);
		border-radius: 0.35rem;
		background:
			linear-gradient(45deg, transparent 50%, var(--site-footer-text, #f2eee6) 50%) calc(100% - 1rem) 50% / 0.42rem 0.42rem no-repeat,
			linear-gradient(135deg, var(--site-footer-text, #f2eee6) 50%, transparent 50%) calc(100% - 0.72rem) 50% / 0.42rem 0.42rem no-repeat,
			var(--site-footer-bg, #0b0b0b);
		color: var(--site-footer-text, #f2eee6);
		font: inherit;
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1;
		appearance: none;
		cursor: pointer;
	}

	.site-footer__country-selector select:focus-visible {
		outline: 2px solid var(--site-footer-focus, currentColor);
		outline-offset: 0.28rem;
	}

	.site-footer--home .site-footer__credit {
		margin-top: 1rem;
		font-size: 0.85rem;
		color: rgba(242, 238, 230, 0.82);
	}

	.site-footer__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 6vw, 5rem);
	}

	.site-footer--home .site-footer__links {
		display: flex;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: end;
	}

	.site-footer__links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.15rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
	}

	.external-link-icon {
		width: 1em;
		height: 1em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.site-footer--home .site-footer__links ul {
		gap: 0.85rem;
		font-size: 0.92rem;
	}

	.site-footer a:focus-visible {
		outline: 2px solid var(--site-footer-focus, currentColor);
		outline-offset: 0.28rem;
	}

	@media (max-width: 920px) {
		.site-footer__inner,
		.site-footer--home .site-footer__inner {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.site-footer--home .site-footer__inner {
			justify-items: center;
		}

		.site-footer--home .site-footer__brand {
			text-align: center;
		}

		.site-footer--home .site-footer__avatar {
			margin-inline: auto;
		}

		.site-footer__links {
			max-width: 30rem;
		}

		.site-footer--home .site-footer__links {
			justify-content: center;
			align-items: start;
		}
	}

	@media (max-width: 640px) {
		.site-footer__brand,
		.site-footer__links ul {
			text-align: center;
			justify-items: center;
		}

		.site-footer__avatar {
			margin-inline: auto;
		}

		.site-footer__country-selector {
			margin-inline: auto;
		}

		.site-footer__links,
		.site-footer--home .site-footer__links {
			justify-self: center;
			display: grid;
			grid-template-columns: repeat(2, minmax(7rem, 1fr));
			gap: clamp(2rem, 10vw, 3rem);
		}
	}
</style>
