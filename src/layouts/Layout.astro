---
import { ClientRouter } from 'astro:transitions';
import {
	artistEmail,
	artistName,
	siteDescription,
	siteImage,
	siteImageAlt,
	siteKeywords,
	siteLocale,
	siteName,
	siteTitle,
	socialLinks,
} from '../data/site';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
}

const {
	title = siteTitle,
	description = siteDescription,
	image = siteImage,
	imageAlt = siteImageAlt,
	noindex = false,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const imageUrl = new URL(image, baseUrl).toString();
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${new URL('/', baseUrl).toString()}#website`,
		name: siteName,
		url: new URL('/', baseUrl).toString(),
		description: siteDescription,
		inLanguage: 'en-MY',
		publisher: {
			'@id': `${new URL('/', baseUrl).toString()}#person`,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		'@id': `${new URL('/', baseUrl).toString()}#person`,
		name: artistName,
		alternateName: siteName,
		jobTitle: 'Painter and illustrator',
		email: `mailto:${artistEmail}`,
		url: new URL('/', baseUrl).toString(),
		image: imageUrl,
		sameAs: socialLinks,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${canonicalUrl}#webpage`,
		url: canonicalUrl,
		name: title,
		description,
		isPartOf: {
			'@id': `${new URL('/', baseUrl).toString()}#website`,
		},
		about: {
			'@id': `${new URL('/', baseUrl).toString()}#person`,
		},
		inLanguage: 'en-MY',
		primaryImageOfPage: {
			'@type': 'ImageObject',
			url: imageUrl,
			caption: imageAlt,
		},
	},
];
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Birthstone&family=Bodoni+Moda:opsz,wght@6..96,700&family=Space+Grotesk:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={artistName} />
		<meta name="keywords" content={siteKeywords.join(', ')} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#f9f5f2" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs summary" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={siteLocale} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<meta name="twitter:creator" content="@whiteyedcat" />
		<script type="application/ld+json" set:html={jsonLdText} />
		<title>{title}</title>
		<ClientRouter fallback="animate" />
	</head>
	<body>
		<div class="route-loader" role="status" aria-live="polite" aria-hidden="true" data-route-loader>
			<span class="route-loader__spinner" aria-hidden="true"></span>
			<span>loading</span>
		</div>
		<slot />
	</body>
</html>

<script>
	const routeLoaderScriptKey = '__whiteyedcatRouteLoaderReady';
	const routeLoaderActiveClass = 'is-route-loading';

	const getRouteLoader = () => document.querySelector<HTMLElement>('[data-route-loader]');

	const showRouteLoader = () => {
		const loader = getRouteLoader();

		document.documentElement.classList.add(routeLoaderActiveClass);
		loader?.setAttribute('aria-hidden', 'false');
	};

	const hideRouteLoader = () => {
		const loader = getRouteLoader();

		document.documentElement.classList.remove(routeLoaderActiveClass);
		loader?.setAttribute('aria-hidden', 'true');
	};

	const isSamePageHashNavigation = (from: URL, to: URL) => {
		return from.pathname === to.pathname && from.search === to.search && from.hash !== to.hash;
	};

	const shouldShowRouteLoader = (event: Event) => {
		if (!('from' in event) || !('to' in event)) return true;

		const transitionEvent = event as Event & { from: URL; to: URL; sourceElement?: Element };
		const sourceElement = transitionEvent.sourceElement;

		if (isSamePageHashNavigation(transitionEvent.from, transitionEvent.to)) return false;

		if (sourceElement instanceof HTMLAnchorElement) {
			if (sourceElement.target && sourceElement.target !== '_self') return false;
			if (sourceElement.hasAttribute('download')) return false;
		}

		return transitionEvent.from.href !== transitionEvent.to.href;
	};

	if (!Reflect.get(window, routeLoaderScriptKey)) {
		Reflect.set(window, routeLoaderScriptKey, true);

		document.addEventListener('astro:before-preparation', (event) => {
			if (shouldShowRouteLoader(event)) {
				showRouteLoader();
			}
		});

		document.addEventListener('astro:after-swap', hideRouteLoader);
		document.addEventListener('astro:page-load', hideRouteLoader);
		window.addEventListener('pageshow', hideRouteLoader);
	}

	hideRouteLoader();
</script>

<style>
	:global(:root) {
		color-scheme: light;
		font-family: 'Space Grotesk', sans-serif;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	@keyframes pageFadeOut {
		from {
			opacity: 1;
		}

		to {
			opacity: 0;
		}
	}

	@keyframes pageFadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	:global(::view-transition-old(root)) {
		animation: pageFadeOut 220ms ease forwards;
	}

	:global(::view-transition-new(root)) {
		animation: pageFadeIn 280ms ease 60ms both;
	}

	:global(.route-loader) {
		position: fixed;
		top: max(1rem, env(safe-area-inset-top));
		left: 50%;
		z-index: 1000;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.5rem;
		padding: 0.62rem 0.9rem;
		border: 2px solid #121212;
		background: #ffffff;
		color: #121212;
		box-shadow: 0 12px 0 rgba(18, 18, 18, 0.16);
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1;
		text-transform: uppercase;
		pointer-events: none;
		opacity: 0;
		transform: translate3d(-50%, -0.75rem, 0);
		transition:
			opacity 160ms ease,
			transform 160ms ease;
	}

	:global(html.is-route-loading .route-loader) {
		opacity: 1;
		transform: translate3d(-50%, 0, 0);
	}

	:global(.route-loader__spinner) {
		width: 0.95rem;
		aspect-ratio: 1;
		border: 2px solid rgba(18, 18, 18, 0.22);
		border-top-color: #5fd0d3;
		border-radius: 50%;
		animation: routeLoaderSpin 720ms linear infinite;
	}

	@keyframes routeLoaderSpin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}

		:global(::view-transition-old(root)),
		:global(::view-transition-new(root)) {
			animation: none;
		}

		:global(.route-loader) {
			transition: none;
		}

		:global(.route-loader__spinner) {
			animation: none;
		}

		:global(.fish-shake) {
			animation: none;
			transform: rotate(var(--fish-rotate, 0deg));
		}
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100vh;
	}

	:global(*),
	:global(*::before),
	:global(*::after) {
		box-sizing: border-box;
	}

	:global(img) {
		display: block;
		max-width: 100%;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	@keyframes fishShake {
		0%,
		25%,
		100% {
			transform: translate3d(0, 0, 0) rotate(var(--fish-rotate, 0deg));
		}

		6% {
			transform: translate3d(4px, -3px, 0) rotate(calc(var(--fish-rotate, 0deg) + 4deg));
		}

		12% {
			transform: translate3d(-5px, 2px, 0) rotate(calc(var(--fish-rotate, 0deg) - 4deg));
		}

		18% {
			transform: translate3d(4px, 3px, 0) rotate(calc(var(--fish-rotate, 0deg) + 3deg));
		}

		23% {
			transform: translate3d(-2px, 1px, 0) rotate(calc(var(--fish-rotate, 0deg) - 2deg));
		}
	}

	:global(.fish-shake) {
		--fish-rotate: 0deg;
		transform-origin: center center;
		animation: fishShake 4s ease-in-out infinite backwards;
		will-change: transform;
	}

	:global(.fish-shake--delay) {
		animation-delay: 2s;
	}
	
	:global(button),
	:global(input),
	:global(textarea),
	:global(select) {
		font: inherit;
	}
 </style>
